<Window x:Class="PianoMidiVisualizationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PianoMidiVisualizationApp.Views"
        xmlns:vm="clr-namespace:PianoMidiVisualizationApp.ViewModels"
        Title="Piano MIDI Visualization"
        Width="1400" Height="620"
        MinWidth="900" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title bar -->
            <RowDefinition Height="*"/>      <!-- stage: readout + keyboard, with the settings overlay -->
            <RowDefinition Height="Auto"/>   <!-- recorder -->
            <RowDefinition Height="Auto"/>   <!-- MIDI log -->
            <RowDefinition Height="Auto"/>   <!-- AI chat -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ===================== Title bar ===================== -->
        <Border Grid.Row="0" Background="{StaticResource Brush.TitleBar}" Height="32"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="app.png" Width="18" Height="18" Margin="10,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Piano MIDI Visualization" Foreground="{StaticResource Brush.Text.Secondary}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Menu VerticalAlignment="Center">
                        <MenuItem Header="_View">
                            <!-- Settings and Zen are command items, not checkable ones: MenuItem.IsChecked
                                 binds two-way by default, so a Command on a checkable item would undo the
                                 click. Neither has a plain settable bool behind it anyway. -->
                            <MenuItem Header="_Settings…" InputGestureText="Ctrl+,"
                                      Command="{Binding ToggleSettingsOverlayCommand}"/>
                            <Separator/>
                            <MenuItem Header="Chord _Progression" InputGestureText="Shift+F4"
                                      IsCheckable="True" IsChecked="{Binding IsProgressionVisible}"/>
                            <MenuItem Header="_AI Music Assistant" InputGestureText="Shift+F2"
                                      IsCheckable="True" IsChecked="{Binding IsChatPanelVisible}"/>
                            <MenuItem Header="_MIDI Log" InputGestureText="Shift+F3"
                                      IsCheckable="True" IsChecked="{Binding IsMidiLogVisible}"/>
                            <MenuItem Header="Status _Bar" InputGestureText="Shift+F1"
                                      IsCheckable="True" IsChecked="{Binding IsStatusBarVisible}"/>
                            <MenuItem Header="_Recorder" InputGestureText="Shift+F5"
                                      IsCheckable="True" IsChecked="{Binding IsRecorderVisible}"/>
                            <Separator/>
                            <MenuItem InputGestureText="F11" Command="{Binding ToggleZenModeCommand}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="Enter _Zen Mode"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                                <Setter Property="Header" Value="Exit _Zen Mode"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="─" Click="MinimizeButton_Click" ToolTip="Minimise"
                            Style="{StaticResource Style.TitleBarButton}"/>
                    <Button Content="□" Click="MaximizeButton_Click" FontSize="14" ToolTip="Maximise"
                            Style="{StaticResource Style.TitleBarButton}"/>
                    <Button Content="✕" Click="CloseButton_Click" ToolTip="Close"
                            Style="{StaticResource Style.TitleBarClose}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Stage ===================== -->
        <Grid Grid.Row="1" Background="{StaticResource Brush.Stage}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>   <!-- collapses to zero with the sidebar -->
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- MinHeight reserves the readout's own lines: on a wide but short window
                         the Auto keyboard row would otherwise take everything and clip it.
                         The Viewbox scales down to whatever height is left. Trimmed from 170
                         to pay for the key selector without squeezing the keyboard at 900x420. -->
                    <RowDefinition Height="*" MinHeight="140"/>   <!-- readout -->
                    <RowDefinition Height="Auto"/>                <!-- practice toolbar -->
                    <RowDefinition Height="Auto"/>                <!-- keyboard -->
                </Grid.RowDefinitions>

                <!-- Chord readout. Every line has a MinHeight so releasing the keys empties the
                     text without collapsing the line box and shifting the layout. -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="24,12">
                    <!-- Line boxes are trimmed to pay for the voicing line: the stack has to fit
                         the 159px row at 900x420, and the 140px MinHeight row an open recorder,
                         log or chat squeezes it to without shaving the chord name. The name's own
                         85px line leaves ~20px empty above the tallest glyph; at 70 a slash or
                         parenthesis still clears the voicing text by the ~4px it used to clear
                         the notes line by. Notes and intervals keep ~1px over their natural line. -->
                    <TextBlock Text="{Binding Analysis.Name}"
                               FontSize="{StaticResource Size.Readout.Name}" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               LineStackingStrategy="BlockLineHeight" LineHeight="70"
                               MinHeight="70" TextAlignment="Center"/>
                    <TextBlock Text="{Binding Analysis.Voicing}"
                               FontSize="{StaticResource Size.Readout.Voicing}"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               MinHeight="19" Margin="0,3,0,0" TextAlignment="Center"/>
                    <TextBlock Text="{Binding Analysis.Notes}" FontFamily="Consolas"
                               FontSize="{StaticResource Size.Readout.Notes}"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               MinHeight="22" TextAlignment="Center"/>
                    <TextBlock Text="{Binding Analysis.Intervals}" FontFamily="Consolas"
                               FontSize="{StaticResource Size.Readout.Intervals}"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               MinHeight="18" TextAlignment="Center"/>
                    <TextBlock Text="Space to save" FontSize="11" Margin="0,4,0,0"
                               Foreground="{StaticResource Brush.Text.Faint}"
                               MinHeight="18" TextAlignment="Center"
                               Visibility="{Binding Analysis.Name,
                                            Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>

                <!-- The keyboard scales to the window. Stretch must be Uniform (never distort a
                     piano) and StretchDirection Both, so it shrinks rather than clipping on a
                     narrow window. MaxHeight stops it from dwarfing the readout on a wide one. -->
                <!-- Key selector. A practice control, so it lives on the stage rather than
                     behind the settings overlay. Both dropdowns write to Settings, which is
                     what persists them; picking a root turns the highlight on. -->
                <Border Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,6"
                        Background="{StaticResource Brush.Surface}" CornerRadius="6"
                        Padding="10,5">
                    <Border.Resources>
                        <!-- Grouping by ScaleOption.Group is what draws the scale list's
                             section headers. The source is static, so no DataContext needed. -->
                        <CollectionViewSource x:Key="ScaleOptionsView"
                                              Source="{x:Static vm:SettingsViewModel.ScaleOptions}">
                            <CollectionViewSource.GroupDescriptions>
                                <PropertyGroupDescription PropertyName="Group"/>
                            </CollectionViewSource.GroupDescriptions>
                        </CollectionViewSource>
                    </Border.Resources>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsZenMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <!-- Practice toolbar: one section per feature, always on one line. When the
                         window is too narrow (below ~1070px with the sidebar open) it scales
                         down rather than wrapping: a second line would push the keyboard off the
                         bottom of the stage at the 900x420 minimum. -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Key" Foreground="{StaticResource Brush.Text.Muted}"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <!-- ItemTemplate, not DisplayMemberPath: the ComboBox template shows
                             SelectionBoxItemTemplate, which DisplayMemberPath does not fill in,
                             so the closed box would fall back to ToString() and print the type
                             name. DeviceInfo overrides ToString(), which is why the settings
                             dropdowns never exposed this. -->
                        <ComboBox Width="76" Height="26"
                                  ItemsSource="{Binding Settings.KeyRoots}"
                                  SelectedValuePath="PitchClass"
                                  SelectedValue="{Binding Settings.KeyTonicPitchClass}"
                                  ToolTip="Key centre">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Not synchronised with the view's current item: that would select
                             its first entry (Major) on load and write it over the saved scale. -->
                        <ComboBox Width="136" Height="26" Margin="6,0,0,0"
                                  ItemsSource="{Binding Source={StaticResource ScaleOptionsView}}"
                                  IsSynchronizedWithCurrentItem="False"
                                  SelectedValuePath="Scale"
                                  SelectedValue="{Binding Settings.KeyScale}"
                                  MaxDropDownHeight="480"
                                  ToolTip="Scale the key is built on">
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="10"
                                                       FontWeight="SemiBold" Margin="8,6,8,2"
                                                       Foreground="{StaticResource Brush.Text.Faint}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Disabled rather than hidden with no key selected: muting is
                             meaningless then, but hiding it would make it undiscoverable. -->
                        <CheckBox Content="Mute out-of-key" Margin="12,0,0,0" FontSize="11"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding Settings.MuteOutOfKeyNotes}"
                                  IsEnabled="{Binding Settings.IsKeyHighlightEnabled}"
                                  ToolTip="Silence notes outside the key. They still light up."/>

                        <Button Content="✕" Width="24" Height="24" Margin="6,0,0,0"
                                Style="{StaticResource Style.IconButton}"
                                Command="{Binding ClearKeyCommand}"
                                VerticalAlignment="Center"
                                ToolTip="Clear key highlight"
                                Visibility="{Binding Settings.IsKeyHighlightEnabled,
                                             Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>

                    <!-- Metronome. None of its buttons take focus: a focused button would claim
                         Space, the save-chord shortcut, for itself. -->
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="1" Margin="12,3" Fill="{StaticResource Brush.Separator}"/>

                        <!-- The toggle carries the beat light: a hollow ring while off, a dim dot
                             while on. BeatFlash is flashed once per click from the audio thread's
                             beat, never from a UI timer (see MainWindow.OnMetronomeBeat), and
                             turns amber on the downbeat. -->
                        <ToggleButton Height="26" Focusable="False"
                                      Style="{StaticResource Style.ToolbarToggle}"
                                      IsChecked="{Binding IsMetronomeOn}"
                                      ToolTip="Metronome on/off (Ctrl+M)">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse StrokeThickness="1.4">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Stroke" Value="{StaticResource Brush.Metronome.Off}"/>
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMetronomeOn}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource Brush.Metronome.On}"/>
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Metronome.On}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Ellipse x:Name="BeatFlash" Opacity="0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Metronome.Beat}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMetronomeAccentBeat}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Metronome.Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Text="&#x2669;" FontFamily="Segoe UI Symbol" FontSize="14"
                                           Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <Button Content="&#x2212;" Width="22" Height="26" Padding="0" Margin="8,0,0,0"
                                Focusable="False" Command="{Binding DecreaseMetronomeBpmCommand}"
                                ToolTip="Slower"/>
                        <!-- Explicit updates: the code-behind commits on Enter or focus loss, then
                             reads the value back, so a clamped or unparseable entry is corrected
                             in place rather than left showing what was typed. -->
                        <TextBox x:Name="MetronomeBpmBox" Width="40" Height="26" Margin="2,0"
                                 Padding="2,0" TextAlignment="Center" MaxLength="3"
                                 Text="{Binding Settings.MetronomeBpm, UpdateSourceTrigger=Explicit}"
                                 Validation.ErrorTemplate="{x:Null}"
                                 PreviewKeyDown="MetronomeBpmBox_PreviewKeyDown"
                                 LostKeyboardFocus="MetronomeBpmBox_LostKeyboardFocus"
                                 PreviewMouseWheel="MetronomeBpmBox_PreviewMouseWheel"
                                 ToolTip="Tempo in BPM, 30 to 240. Enter to apply; scroll or Up/Down to nudge."/>
                        <Button Content="+" Width="22" Height="26" Padding="0"
                                Focusable="False" Command="{Binding IncreaseMetronomeBpmCommand}"
                                ToolTip="Faster"/>

                        <!-- Press, not release: a tap should land when the finger does. -->
                        <Button Content="Tap" Height="26" Padding="7,0" Margin="6,0,0,0"
                                Focusable="False" ClickMode="Press"
                                Command="{Binding TapMetronomeCommand}"
                                ToolTip="Tap the beat to set the tempo"/>

                        <ComboBox Width="56" Height="26" Margin="6,0,0,0"
                                  ItemsSource="{Binding Settings.MetronomeBeatsPerBarOptions}"
                                  SelectedItem="{Binding Settings.MetronomeBeatsPerBar}"
                                  ToolTip="Beats per bar. Beat 1 is accented; 1 means no accent.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0}/4}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Recorder transport: record, play/stop, loop, speed -->
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="1" Margin="12,3" Fill="{StaticResource Brush.Separator}"/>
                        <views:RecorderTransport DataContext="{Binding Recorder}" VerticalAlignment="Center"/>
                    </StackPanel>
                    </StackPanel>
                    </Viewbox>
                </Border>

                <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="Both"
                         MaxHeight="360" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="16,16,16,0" TextOptions.TextFormattingMode="Ideal">
                    <views:PianoKeyboardControl DataContext="{Binding PianoKeyboard}"/>
                </Viewbox>
            </Grid>

            <!-- Chord progression sidebar -->
            <Border Grid.Column="1" Background="{StaticResource Brush.Surface}" Width="200" Padding="8"
                    Visibility="{Binding IsProgressionVisible, Converter={StaticResource BoolToVisConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Chord Progression"
                               Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SavedChords.Count, StringFormat='{}{0}/8 chords'}"
                               Foreground="{StaticResource Brush.Text.Faint}" FontSize="10" Margin="0,8,0,0"/>
                    <ItemsControl ItemsSource="{Binding SavedChords}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Brush.SurfaceRaised}" CornerRadius="4"
                                        Margin="0,0,0,6" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ChordName}"
                                                       Foreground="{StaticResource Brush.Text.Primary}"
                                                       FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding NotesDisplay}"
                                                       Foreground="{StaticResource Brush.Text.Muted}"
                                                       FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <!-- The sidebar stays in the window's visual tree (this is one
                                             reason the settings overlay is a Grid child, not a Popup) -->
                                        <Button Grid.Column="1" Content="✕"
                                                Style="{StaticResource Style.IconButton}"
                                                Command="{Binding DataContext.RemoveChordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Top" ToolTip="Remove chord"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Settings overlay: scrim first, panel second, so the panel paints on top.
                 Both span the stage; neither displaces the keyboard. -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Brush.Scrim}"
                    Visibility="{Binding IsSettingsOverlayVisible, Converter={StaticResource BoolToVisConverter}}"
                    MouseLeftButtonDown="SettingsScrim_MouseLeftButtonDown"/>

            <Border Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top"
                    Background="{StaticResource Brush.SurfaceAlt}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                    Visibility="{Binding IsSettingsOverlayVisible, Converter={StaticResource BoolToVisConverter}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="32"
                            Style="{StaticResource Style.IconButton}"
                            Command="{Binding CloseSettingsOverlayCommand}"
                            VerticalAlignment="Top" Margin="4,4,8,0"
                            ToolTip="Close settings (Esc)"/>
                    <!-- No DataContext override here on purpose: SettingsPanel's code-behind seeds the
                         API key box by casting DataContext to MainViewModel. Interposing anything
                         else silently stops the saved key from appearing. -->
                    <views:SettingsPanel/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===================== Recorder ===================== -->
        <Border Grid.Row="2"
                Visibility="{Binding IsRecorderVisible, Converter={StaticResource BoolToVisConverter}}">
            <views:RecorderPanel DataContext="{Binding Recorder}"/>
        </Border>

        <!-- ===================== MIDI log ===================== -->
        <Border Grid.Row="3" Background="{StaticResource Brush.TitleBar}" Height="120" Padding="4"
                Visibility="{Binding IsMidiLogVisible, Converter={StaticResource BoolToVisConverter}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="MIDI Log" Foreground="{StaticResource Brush.Text.Muted}"
                           FontSize="11" Margin="4,0,0,2"/>
                <ListBox ItemsSource="{Binding MidiLog}"
                         Background="{StaticResource Brush.Console}" Foreground="{StaticResource Brush.Log.Text}"
                         FontFamily="Consolas" FontSize="11"
                         BorderThickness="0"
                         x:Name="MidiLogList"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2,0"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Log.Text}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== AI chat =====================
             The wrapper carries the visibility binding so it resolves against MainViewModel;
             ChatPanel keeps its own ChatViewModel DataContext. -->
        <Border Grid.Row="4"
                Visibility="{Binding IsChatPanelVisible, Converter={StaticResource BoolToVisConverter}}">
            <views:ChatPanel DataContext="{Binding Chat}"/>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Border Grid.Row="5" Background="{StaticResource Brush.Surface}" Padding="10,4"
                Visibility="{Binding IsStatusBarVisible, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
