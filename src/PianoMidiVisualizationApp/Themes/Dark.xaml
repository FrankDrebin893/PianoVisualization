<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ================= Surfaces ================= -->
    <SolidColorBrush x:Key="Brush.Window"         Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Brush.TitleBar"       Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Brush.Surface"        Color="#252525"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt"     Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Brush.SurfaceRaised"  Color="#303030"/>
    <SolidColorBrush x:Key="Brush.Stage"          Color="#333333"/>
    <SolidColorBrush x:Key="Brush.Console"        Color="#111111"/>
    <SolidColorBrush x:Key="Brush.InputArea"      Color="#202020"/>
    <SolidColorBrush x:Key="Brush.Input"          Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Brush.Scrim"          Color="#B3000000"/>
    <SolidColorBrush x:Key="Brush.Popup.Background" Color="#252525"/>
    <SolidColorBrush x:Key="Brush.Popup.Border"     Color="#3F3F3F"/>

    <!-- ================= Text ================= -->
    <SolidColorBrush x:Key="Brush.Text.Primary"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary"  Color="#AAAAAA"/>
    <SolidColorBrush x:Key="Brush.Text.Muted"     Color="#888888"/>
    <SolidColorBrush x:Key="Brush.Text.Faint"     Color="#666666"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled"  Color="#5A5A5A"/>

    <!-- ================= Lines & states ================= -->
    <SolidColorBrush x:Key="Brush.Border"         Color="#444444"/>
    <SolidColorBrush x:Key="Brush.Separator"      Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.Hover"          Color="#333333"/>
    <SolidColorBrush x:Key="Brush.Accent"         Color="#2B5278"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover"   Color="#35659A"/>
    <SolidColorBrush x:Key="Brush.Danger"         Color="#C42B1C"/>
    <SolidColorBrush x:Key="Brush.Danger.Muted"   Color="#664444"/>
    <SolidColorBrush x:Key="Brush.Danger.Text"    Color="#FF6666"/>
    <SolidColorBrush x:Key="Brush.Warning"        Color="#AA6600"/>
    <SolidColorBrush x:Key="Brush.Error.Background" Color="#442222"/>
    <SolidColorBrush x:Key="Brush.Error.Text"       Color="#FF8888"/>

    <!-- ================= MIDI / log ================= -->
    <SolidColorBrush x:Key="Brush.Midi.Idle"      Color="#555555"/>
    <SolidColorBrush x:Key="Brush.Midi.Connected" Color="#337733"/>
    <SolidColorBrush x:Key="Brush.Midi.Active"    Color="#00FF00"/>
    <SolidColorBrush x:Key="Brush.Log.Text"       Color="#00DD00"/>

    <!-- ================= Metronome beat light ================= -->
    <SolidColorBrush x:Key="Brush.Metronome.Off"    Color="#777777"/>
    <SolidColorBrush x:Key="Brush.Metronome.On"     Color="#6F93B8"/>
    <SolidColorBrush x:Key="Brush.Metronome.Beat"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Metronome.Accent" Color="#FFB547"/>

    <!-- ================= Circle of fifths =================
         The selected key is amber, echoing the keyboard's tonic fill; its neighbours and
         relative take a faint wash of the same. The chord-root outline is the pressed-key
         blue, since it follows what is being played. -->
    <SolidColorBrush x:Key="Brush.Circle.Major"      Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Brush.Circle.Minor"      Color="#232323"/>
    <SolidColorBrush x:Key="Brush.Circle.Related"    Color="#3F3727"/>
    <SolidColorBrush x:Key="Brush.Circle.Selected"   Color="#7E6128"/>
    <SolidColorBrush x:Key="Brush.Circle.Hover"      Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Brush.Circle.RootMarker" Color="#50A0EB"/>

    <!-- ================= Grand staff =================
         Lines recede, the clefs and key signature sit a step forward, and the notes you are
         holding are full white like the chord name, so the eye goes straight to them. -->
    <SolidColorBrush x:Key="Brush.Staff.Line"   Color="#7A7A7A"/>
    <SolidColorBrush x:Key="Brush.Staff.Symbol" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="Brush.Staff.Note"   Color="#FFFFFF"/>

    <!-- ================= Song practice (falling notes) =================
         Parts follow the practice-app convention of green for the right hand and blue for the
         left; the rest are distinct and stay clear of the keyboard's magenta hint and its blue
         pressed fill. Auto-play notes use the same hues, drawn translucent by the view. -->
    <SolidColorBrush x:Key="Brush.Song.Lane"        Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Brush.Song.OctaveLine"  Color="#333333"/>
    <SolidColorBrush x:Key="Brush.Song.GroupLine"   Color="#242424"/>
    <SolidColorBrush x:Key="Brush.Song.BarLine"     Color="#303030"/>
    <SolidColorBrush x:Key="Brush.Song.BarNumber"   Color="#5E5E5E"/>
    <SolidColorBrush x:Key="Brush.Song.HitLine"     Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Brush.Song.Sounding"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Song.Loop"        Color="#F2C978"/>
    <SolidColorBrush x:Key="Brush.Song.OutsideLoop" Color="#8C000000"/>
    <SolidColorBrush x:Key="Brush.Song.Folded"      Color="#F0F0F0"/>
    <!-- The chord wait mode is holding for: the keyboard's hint magenta, so note and key match. -->
    <SolidColorBrush x:Key="Brush.Song.Target"      Color="#E83E9C"/>
    <SolidColorBrush x:Key="Brush.Song.Correct"     Color="#8BE36B"/>
    <SolidColorBrush x:Key="Brush.Song.Wrong"       Color="#FF5252"/>
    <SolidColorBrush x:Key="Brush.Song.Overlay"     Color="#CC1A1A1A"/>
    <SolidColorBrush x:Key="Brush.Song.Part0"       Color="#6CC24A"/>   <!-- right hand -->
    <SolidColorBrush x:Key="Brush.Song.Part1"       Color="#5B8DEF"/>   <!-- left hand -->
    <SolidColorBrush x:Key="Brush.Song.Part2"       Color="#E8A33D"/>
    <SolidColorBrush x:Key="Brush.Song.Part3"       Color="#3FC1B0"/>
    <SolidColorBrush x:Key="Brush.Song.Part4"       Color="#B39DDB"/>
    <SolidColorBrush x:Key="Brush.Song.Part5"       Color="#E07A7A"/>

    <!-- ================= Roman numerals =================
         A diatonic numeral reads near-white like the chord name above it. The other kinds
         take a desaturated tint, kept clear of the circle's key amber and chord-root blue,
         and name themselves in a small muted tag, so colour is never the only cue. -->
    <SolidColorBrush x:Key="Brush.Function.Diatonic"  Color="#EDEDED"/>
    <SolidColorBrush x:Key="Brush.Function.Secondary" Color="#7FCFB0"/>
    <SolidColorBrush x:Key="Brush.Function.Borrowed"  Color="#B4A2EE"/>
    <SolidColorBrush x:Key="Brush.Function.Chromatic" Color="#E39B9B"/>

    <!-- For a Run whose DataContext has Function and FunctionKind: ChordAnalysis, SavedChord. -->
    <Style x:Key="Style.Function.Numeral" TargetType="Run">
        <Setter Property="Foreground" Value="{StaticResource Brush.Function.Diatonic}"/>
        <Setter Property="ToolTip" Value="Roman numeral in the selected key"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding FunctionKind}" Value="SecondaryDominant">
                <Setter Property="Foreground" Value="{StaticResource Brush.Function.Secondary}"/>
                <Setter Property="ToolTip" Value="Secondary dominant: the V or vii° of the chord after the slash"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FunctionKind}" Value="Borrowed">
                <Setter Property="Foreground" Value="{StaticResource Brush.Function.Borrowed}"/>
                <Setter Property="ToolTip" Value="Borrowed from the parallel major or minor"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FunctionKind}" Value="Chromatic">
                <Setter Property="Foreground" Value="{StaticResource Brush.Function.Chromatic}"/>
                <Setter Property="ToolTip" Value="Chromatic: outside the key and its parallel major and minor"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The kind in words after a non-diatonic numeral. Text comes only from here; the last
         trigger blanks it while there is no numeral to label. -->
    <Style x:Key="Style.Function.Tag" TargetType="Run">
        <Setter Property="Text" Value=""/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding FunctionKind}" Value="SecondaryDominant">
                <Setter Property="Text" Value=" secondary"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FunctionKind}" Value="Borrowed">
                <Setter Property="Text" Value=" borrowed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FunctionKind}" Value="Chromatic">
                <Setter Property="Text" Value=" chromatic"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Function}" Value="">
                <Setter Property="Text" Value=""/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Between the numeral and the voicing on the readout (DataContext: ChordAnalysis), only
         while both are showing. The dot matches the one inside the voicing text. -->
    <Style x:Key="Style.Function.VoicingSeparator" TargetType="Run">
        <Setter Property="Text" Value=" · "/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Faint}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Function}" Value="">
                <Setter Property="Text" Value=""/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Voicing}" Value="">
                <Setter Property="Text" Value=""/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Diatonic chord strip =================
         Tiles sit dark like the toolbar. The one matching what's held takes the pressed-key
         blue, and a hovered tile's outline is the keyboard's hint magenta, tying it to the
         markers it draws on the keys. -->
    <SolidColorBrush x:Key="Brush.ChordTile"              Color="#282828"/>
    <SolidColorBrush x:Key="Brush.ChordTile.Border"       Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.ChordTile.Hover"        Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.ChordTile.Hint"         Color="#E83E9C"/>
    <SolidColorBrush x:Key="Brush.ChordTile.Played"       Color="#2B5278"/>
    <SolidColorBrush x:Key="Brush.ChordTile.PlayedBorder" Color="#50A0EB"/>

    <!-- A chord tile (DataContext: ChordTileViewModel). One line, 22px tall: the strip has
         only 24px to spend at the 900x420 minimum before the readout drops below its MinHeight.
         Never focusable, or a clicked tile would take Space, the save-chord shortcut. All the
         colours are Setters, since a local value would outrank the triggers. -->
    <Style x:Key="Style.ChordTile" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinWidth" Value="52"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource Brush.ChordTile}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ChordTile.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.ChordTile.Hover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.ChordTile.Hint}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsPlayed}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.ChordTile.Played}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.ChordTile.PlayedBorder}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            </DataTrigger>
            <!-- Played and hovered: keep the blue fill, but still show the hint outline. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPlayed}" Value="True"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.ChordTile.Hint}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Readout type scale ================= -->
    <sys:Double x:Key="Size.Readout.Name">64</sys:Double>
    <sys:Double x:Key="Size.Readout.Voicing">14</sys:Double>
    <!-- Sized to share the voicing line's 19px block line box without growing it -->
    <sys:Double x:Key="Size.Readout.Function">18</sys:Double>
    <sys:Double x:Key="Size.Readout.Notes">18</sys:Double>
    <sys:Double x:Key="Size.Readout.Intervals">14</sys:Double>

    <!-- =========================================================================
         Menu. The stock WPF MenuItem template is light-themed, and setting only
         Foreground/Background leaves the dropdown popup light on a dark title bar,
         so the templates have to be replaced outright.
         ========================================================================= -->

    <!-- A top-level header such as "View" — this is where the dropdown popup lives. -->
    <ControlTemplate x:Key="Menu.TopLevelHeader" TargetType="MenuItem">
        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}" CornerRadius="3">
            <Grid>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center"/>
                <!-- AllowsTransparency stays False: a transparent popup layered over an
                     AllowsTransparency window softens text on some GPUs. -->
                <Popup x:Name="PART_Popup" AllowsTransparency="False" Focusable="False"
                       IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom"
                       PopupAnimation="None" VerticalOffset="4" HorizontalOffset="-8">
                    <Border Background="{StaticResource Brush.Popup.Background}"
                            BorderBrush="{StaticResource Brush.Popup.Border}" BorderThickness="1"
                            Padding="0,4" MinWidth="200">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A top-level item with no submenu. -->
    <ControlTemplate x:Key="Menu.TopLevelItem" TargetType="MenuItem">
        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}" CornerRadius="3">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                              VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A leaf item inside a dropdown: check column, header, right-aligned gesture text. -->
    <ControlTemplate x:Key="Menu.SubmenuItem" TargetType="MenuItem">
        <Border x:Name="Bg" Background="Transparent" Padding="0,6" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path x:Name="Check" Grid.Column="0" Visibility="Collapsed"
                      Data="M 0,4.5 L 3.4,8 L 9,1"
                      Stroke="{StaticResource Brush.Text.Primary}" StrokeThickness="1.6"
                      StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center"/>

                <TextBlock x:Name="Gesture" Grid.Column="2"
                           Text="{TemplateBinding InputGestureText}"
                           Foreground="{StaticResource Brush.Text.Faint}" FontSize="11"
                           VerticalAlignment="Center" Margin="28,0,14,0"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
                <Setter TargetName="Gesture" Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A nested submenu header: same row, plus an arrow and a side-placed popup. -->
    <ControlTemplate x:Key="Menu.SubmenuHeader" TargetType="MenuItem">
        <Border x:Name="Bg" Background="Transparent" Padding="0,6" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center"/>

                <Path Grid.Column="2" Data="M 0,0 L 4,4 L 0,8" Margin="28,0,10,0"
                      Stroke="{StaticResource Brush.Text.Muted}" StrokeThickness="1.4"
                      VerticalAlignment="Center"/>

                <Popup x:Name="PART_Popup" AllowsTransparency="False" Focusable="False"
                       IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right"
                       PopupAnimation="None" HorizontalOffset="-2">
                    <Border Background="{StaticResource Brush.Popup.Background}"
                            BorderBrush="{StaticResource Brush.Popup.Border}" BorderThickness="1"
                            Padding="0,4" MinWidth="180">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template" Value="{StaticResource Menu.SubmenuItem}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource Menu.TopLevelHeader}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource Menu.TopLevelItem}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource Menu.SubmenuHeader}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Keyed off MenuItem.SeparatorStyleKey so it only affects separators inside menus. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="26,4,8,4"/>
        <Setter Property="Background" Value="{StaticResource Brush.Separator}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel IsItemsHost="True" Orientation="Horizontal"
                                Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================
         Input controls. The settings panel is now a focal overlay, so its stock
         light-chrome controls have to be darkened to match.
         Note: a local <Button.Style> without BasedOn replaces these outright.
         ========================================================================= -->

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Input}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Brush.Input}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Brush.Input}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- A zero-opacity ToggleButton covering the whole control is the standard
                             way to keep click-to-open without theming the stock button chrome. -->
                        <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{StaticResource Brush.Input}"
                                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="3" SnapsToDevicePixels="True">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,9,0" Data="M 0,0 L 4,4 L 8,0"
                                              Stroke="{StaticResource Brush.Text.Muted}" StrokeThickness="1.4"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{StaticResource Brush.Text.Muted}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <Popup x:Name="PART_Popup" AllowsTransparency="False" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               PopupAnimation="None"
                               MinWidth="{TemplateBinding ActualWidth}">
                            <Border Background="{StaticResource Brush.Popup.Background}"
                                    BorderBrush="{StaticResource Brush.Popup.Border}" BorderThickness="1"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <!-- ItemsPresenter, not a bare IsItemsHost panel: grouping (the
                                     scale picker's section headers) generates each group's items
                                     through it, and without it every group renders empty. The
                                     default ItemsPanel is still a StackPanel. -->
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chromeless buttons. Background/Foreground are Setters, not attributes on the element:
         a local value outranks a Style trigger, so an inline Background="Transparent" would
         stop the hover highlight from ever painting. -->
    <ControlTemplate x:Key="Template.FlatButton" TargetType="Button">
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </ControlTemplate>

    <Style x:Key="Style.TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template" Value="{StaticResource Template.FlatButton}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Style.TitleBarClose" TargetType="Button" BasedOn="{StaticResource Style.TitleBarButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Danger}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small transparent glyph button: the overlay's close ✕ and the remove-chord ✕. -->
    <Style x:Key="Style.IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource Template.FlatButton}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Danger.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A button that stays down while its feature is on, e.g. the metronome. Keyed rather
         than implicit so the ComboBox's internal ToggleButton is unaffected. -->
    <Style x:Key="Style.ToolbarToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent.Hover}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource Brush.Border}" StrokeThickness="1.4"
                                     Fill="{StaticResource Brush.Input}"/>
                            <Ellipse x:Name="Dot" Width="6" Height="6" Visibility="Collapsed"
                                     Fill="{StaticResource Brush.Text.Primary}"/>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Text.Muted}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Text.Muted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mirrors the RadioButton above: a square box with a tick instead of a ring with a dot.
         Without this the stock CheckBox chrome renders light against the dark stage. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="14" Height="14" CornerRadius="3"
                                VerticalAlignment="Center" Margin="0,0,6,0"
                                Background="{StaticResource Brush.Input}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1.4">
                            <Path x:Name="Tick" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0,3 L 2.6,5.6 L 7,0.6"
                                  Stroke="{StaticResource Brush.Text.Primary}" StrokeThickness="1.6"
                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Text.Muted}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Text.Muted}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
                            <Setter TargetName="Tick" Property="Stroke" Value="{StaticResource Brush.Text.Disabled}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
