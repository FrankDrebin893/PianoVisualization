<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ================= Icons ================= -->
    <!-- The one icon set: Segoe MDL2 Assets, which every supported Windows ships. Glyph buttons
         use these codes rather than Unicode look-alikes (✕, ↻, □), whose weight and size
         change with the text font around them. First in the file: a StaticResource can't see
         a key defined below it, and a style that misses this one falls back to a text font
         and draws empty boxes.
         Close / remove / clear: E711. Title bar: E921 minimise, E922 maximise, E923 restore,
         E8BB close. Refresh: E72C. -->
    <FontFamily x:Key="Font.Icon">Segoe MDL2 Assets</FontFamily>

    <!-- ================= Palette =================
         Scarlet anodised (2026-10-20, docs/design-concepts/Scarlet.dc.html): the window is an
         instrument's front panel. The chrome is brushed scarlet aluminium with white legends;
         the stage is a black OLED window set into it; the keys below are real ivory and ebony.
         Surfaces, text, states and the brand hues are built from these colours; the key
         gradients and song-part hues set their own stops in their sections below. Nothing
         outside this file picks a colour. Colours first, for the same reason as Font.Icon above.

         The "Lacquer" names are kept from the piano-character theme so every brush below and
         in the renderers still resolves.
           Deep    wells the eye reads into: the song lane, the take timeline, the MIDI log
           Chrome  the panel: brushed scarlet behind the title bar, sidebar, toolbar, status bar
           Stage   the OLED window the readout sits in: true black
           Raised  black rubber controls and tiles at rest
           Hover   a control under the pointer; dividers
           Line    borders, and the strongest fill: a selected or sounding row -->
    <Color x:Key="Color.Lacquer.Deep">#060606</Color>
    <Color x:Key="Color.Lacquer.Chrome">#A8131C</Color>
    <Color x:Key="Color.Lacquer.Stage">#000000</Color>
    <Color x:Key="Color.Lacquer.Raised">#1C1C1C</Color>
    <Color x:Key="Color.Lacquer.Hover">#2E2E2E</Color>
    <Color x:Key="Color.Lacquer.Line">#3E3E3E</Color>

    <!-- White legends, brightest first. The same ramp is read on the scarlet panel and on the
         black OLED, so it is set by the panel: Muted and brighter clear 4.5:1 on Chrome (and
         far more on black). Faint is below that, so it draws marks (staff lines, the
         metronome's dot, scroll thumbs), never words. The "Ivory" names stay for the renderers. -->
    <Color x:Key="Color.Ivory.Key">#FCFCFB</Color>
    <Color x:Key="Color.Ivory.Primary">#FFFFFF</Color>
    <Color x:Key="Color.Ivory.Pressed">#F4F2EE</Color>    <!-- a control that is switched on -->
    <Color x:Key="Color.Ivory.Secondary">#F0EEEC</Color>
    <Color x:Key="Color.Ivory.Tertiary">#DCDAD8</Color>
    <Color x:Key="Color.Ivory.Muted">#D0CECC</Color>
    <Color x:Key="Color.Ivory.Faint">#8E8C8A</Color>
    <Color x:Key="Color.Ivory.Disabled">#7C7A78</Color>
    <!-- Ink on a white "on" key or the white played tile. -->
    <Color x:Key="Color.Ink">#0A0A0A</Color>

    <!-- Amber, the one brand hue after the panel itself. Only for the key centre and for
         whatever is waiting on you; never decoration, and never just "this control is on"
         (that is white). -->
    <Color x:Key="Color.Amber">#F0C06A</Color>            <!-- text and glyphs, the attention dot -->
    <Color x:Key="Color.Amber.Pale">#E9C47E</Color>       <!-- the in-key mark on an ebony or held key -->
    <Color x:Key="Color.Amber.Strong">#EDA73C</Color>     <!-- marks: the tonic's edge, learn listening -->
    <Color x:Key="Color.Amber.Deep">#6E4F1C</Color>       <!-- the selected key's wedge, under white text -->
    <Color x:Key="Color.Amber.Border">#8A6A30</Color>
    <Color x:Key="Color.Amber.WashHover">#463820</Color>
    <Color x:Key="Color.Amber.Wash">#3A2E1B</Color>       <!-- a wash on the stage -->
    <Color x:Key="Color.Amber.Fill">#2A2215</Color>       <!-- a wash on a black control; the circle's related keys -->
    <Color x:Key="Color.Amber.Ink">#1C1609</Color>        <!-- text on an amber fill -->

    <!-- Every other hue has one job, the same in every widget:
           blue     you are playing: a held key, the circle's root marker, the lit chord tile,
                    your recorded notes
           magenta  the app asking for a key: a chord to try, the song's next notes
           teal     your right hand in a song; violet your left
           green    you hit it; red you missed it, and (by convention) recording -->
    <!-- Blue stays "you are playing": the lit edge of a held key, the circle's root marker,
         your recorded notes. -->
    <Color x:Key="Color.Blue">#4FA3FF</Color>
    <Color x:Key="Color.Target">#E83E9C</Color>
    <Color x:Key="Color.Correct">#8BE36B</Color>
    <Color x:Key="Color.Wrong">#FF5252</Color>
    <Color x:Key="Color.Record">#F04A3E</Color>
    <Color x:Key="Color.Record.Idle">#9C4A42</Color>
    <Color x:Key="Color.Shadow">#000000</Color>

    <!-- ================= Type =================
         Inter Tight carries every word, set tight like a panel legend; JetBrains Mono holds the
         numbers that change still. Both are bundled (Fonts/), so the look doesn't depend on
         what Windows has installed. The URIs are assembly-qualified so the screenshot harness,
         a different entry assembly, finds them too. -->
    <FontFamily x:Key="Font.Body">pack://application:,,,/PianoMidiVisualizationApp;component/Fonts/#Inter Tight</FontFamily>
    <FontFamily x:Key="Font.Data">pack://application:,,,/PianoMidiVisualizationApp;component/Fonts/#JetBrains Mono</FontFamily>

    <!-- ================= The panel =================
         The brushed anodising itself is Brush.Window, Brush.TitleBar and Brush.Surface below:
         hairline grain over the scarlet, tiled in absolute units so every panel shares one
         grain and the seams vanish. Three copies, because a StaticResource alias defined in
         this merged dictionary is not found from the window. -->

    <!-- The window's rounded outline: a darker edge round the anodised sheet. -->
    <SolidColorBrush x:Key="Brush.Window.Rim" Color="#5C0A10"/>

    <!-- The OLED window's bezel: a black frame a step proud of the panel, with a lit lip. -->
    <SolidColorBrush x:Key="Brush.Oled.Bezel" Color="#0C0C0C"/>
    <SolidColorBrush x:Key="Brush.Oled.Lip"   Color="#40FFFFFF"/>
    <!-- The felt strip between the panel and the keys. -->
    <SolidColorBrush x:Key="Brush.Felt"       Color="#111111"/>

    <!-- The halo knobs (HaloKnob): a black cap in a dark recess, ringed by level LEDs. The
         halo is a meter, so it uses a meter's convention, green rising through amber to red
         near the top. That is the one place green and red mean a level rather than a hit or
         a miss, and it never appears on the keys, the strip or the song lane. -->
    <SolidColorBrush x:Key="Brush.Knob.Recess"    Color="#120708"/>
    <SolidColorBrush x:Key="Brush.Knob.RecessRim" Color="#33FFFFFF"/>
    <RadialGradientBrush x:Key="Brush.Knob.Cap" GradientOrigin="0.4,0.3" Center="0.45,0.4" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#3E3E3E" Offset="0"/>
        <GradientStop Color="#1A1A1A" Offset="0.7"/>
        <GradientStop Color="#0E0E0E" Offset="1"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Brush.Knob.CapRim"    Color="#000000"/>
    <SolidColorBrush x:Key="Brush.Knob.Pointer"   Color="{StaticResource Color.Ivory.Primary}"/>
    <SolidColorBrush x:Key="Brush.Halo.Off"       Color="#2A1214"/>
    <SolidColorBrush x:Key="Brush.Halo.Low"       Color="#5DFF7A"/>
    <SolidColorBrush x:Key="Brush.Halo.Mid"       Color="#FFC23A"/>
    <SolidColorBrush x:Key="Brush.Halo.High"      Color="#FF4A3A"/>

    <!-- ================= Surfaces ================= -->
    <DrawingBrush x:Key="Brush.Window" TileMode="Tile" Viewport="0,0,4,64" ViewportUnits="Absolute"
                  Viewbox="0,0,4,64" ViewboxUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 0,0 H 4 V 64 H 0 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="{StaticResource Color.Lacquer.Chrome}"/>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0DFFFFFF" Geometry="M 0,0 H 1 V 64 H 0 Z"/>
                <GeometryDrawing Brush="#12000000" Geometry="M 1,0 H 2 V 64 H 1 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="Brush.TitleBar" TileMode="Tile" Viewport="0,0,4,64" ViewportUnits="Absolute"
                  Viewbox="0,0,4,64" ViewboxUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 0,0 H 4 V 64 H 0 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="{StaticResource Color.Lacquer.Chrome}"/>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0DFFFFFF" Geometry="M 0,0 H 1 V 64 H 0 Z"/>
                <GeometryDrawing Brush="#12000000" Geometry="M 1,0 H 2 V 64 H 1 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- Panels: the sidebar, recorder, song bar, status bar and the toolbar strip on the stage. -->
    <DrawingBrush x:Key="Brush.Surface" TileMode="Tile" Viewport="0,0,4,64" ViewportUnits="Absolute"
                  Viewbox="0,0,4,64" ViewboxUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 0,0 H 4 V 64 H 0 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="{StaticResource Color.Lacquer.Chrome}"/>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0DFFFFFF" Geometry="M 0,0 H 1 V 64 H 0 Z"/>
                <GeometryDrawing Brush="#12000000" Geometry="M 1,0 H 2 V 64 H 1 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- Something laid over the stage: the settings drawer, a card over the song lane. The
         scrim or the deep lane beneath is what sets it apart. -->
    <SolidColorBrush x:Key="Brush.SurfaceAlt"     Color="{StaticResource Color.Lacquer.Stage}"/>
    <SolidColorBrush x:Key="Brush.SurfaceRaised"  Color="{StaticResource Color.Lacquer.Raised}"/>
    <SolidColorBrush x:Key="Brush.Stage"          Color="{StaticResource Color.Lacquer.Stage}"/>
    <SolidColorBrush x:Key="Brush.Console"        Color="{StaticResource Color.Lacquer.Deep}"/>
    <SolidColorBrush x:Key="Brush.InputArea"      Color="{StaticResource Color.Lacquer.Stage}"/>
    <SolidColorBrush x:Key="Brush.Input"          Color="{StaticResource Color.Lacquer.Raised}"/>
    <!-- A control that can't be used: a dead black key, never the panel's scarlet, which
         would read as a lit red button. -->
    <SolidColorBrush x:Key="Brush.Disabled"       Color="#141414"/>
    <SolidColorBrush x:Key="Brush.Scrim"          Color="#B3000000"/>
    <SolidColorBrush x:Key="Brush.Popup.Background" Color="{StaticResource Color.Lacquer.Raised}"/>
    <SolidColorBrush x:Key="Brush.Popup.Border"     Color="{StaticResource Color.Lacquer.Line}"/>

    <!-- ================= Text ================= -->
    <SolidColorBrush x:Key="Brush.Text.Primary"   Color="{StaticResource Color.Ivory.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Ivory.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary"  Color="{StaticResource Color.Ivory.Tertiary}"/>
    <SolidColorBrush x:Key="Brush.Text.Muted"     Color="{StaticResource Color.Ivory.Muted}"/>
    <!-- Text that could go if space ran out ("4/8 chords", shortcut hints). Words still clear
         4.5:1 at arm's length, so it shares Muted's ink; the name keeps the intent. -->
    <SolidColorBrush x:Key="Brush.Text.Faint"     Color="{StaticResource Color.Ivory.Muted}"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled"  Color="{StaticResource Color.Ivory.Disabled}"/>
    <!-- An instruction on the stage ("Space to save"). It stays secondary by its small size and
         place under the readout, not by dropping below 4.5:1 on Brush.Stage as Faint does. -->
    <SolidColorBrush x:Key="Brush.Text.Hint"      Color="{StaticResource Color.Ivory.Muted}"/>

    <!-- ================= Lines & states =================
         Ink, not boxes: buttons carry no border at rest, only inputs do. -->
    <SolidColorBrush x:Key="Brush.Border"         Color="{StaticResource Color.Lacquer.Line}"/>
    <SolidColorBrush x:Key="Brush.Separator"      Color="{StaticResource Color.Lacquer.Hover}"/>
    <SolidColorBrush x:Key="Brush.Hover"          Color="{StaticResource Color.Lacquer.Hover}"/>
    <SolidColorBrush x:Key="Brush.Selected"       Color="{StaticResource Color.Lacquer.Line}"/>
    <!-- On means ivory: a switched-on toggle (metronome, loop, 7ths) or a primary action is an
         ivory keytop with lacquer ink, rather than borrowing the held-key blue. -->
    <SolidColorBrush x:Key="Brush.On"             Color="{StaticResource Color.Ivory.Pressed}"/>
    <SolidColorBrush x:Key="Brush.On.Hover"       Color="{StaticResource Color.Ivory.Primary}"/>
    <SolidColorBrush x:Key="Brush.On.Ink"         Color="{StaticResource Color.Ink}"/>
    <!-- A progression chord while it plays back: the strongest lacquer, edged in ivory. -->
    <SolidColorBrush x:Key="Brush.Sounding.Border" Color="{StaticResource Color.Ivory.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Focus"          Color="{StaticResource Color.Ivory.Secondary}"/>
    <!-- A scrollbar thumb: a mark, so Faint's ink. It clears 3:1 where thumbs sit: the deep
         wells (4.2:1), chrome and raised panels. -->
    <SolidColorBrush x:Key="Brush.ScrollThumb"    Color="{StaticResource Color.Ivory.Faint}"/>
    <SolidColorBrush x:Key="Brush.Danger"         Color="#C42B1C"/>   <!-- Windows' own close-button red -->
    <SolidColorBrush x:Key="Brush.Danger.Text"    Color="#F0736A"/>
    <SolidColorBrush x:Key="Brush.Warning"        Color="{StaticResource Color.Amber.Strong}"/>
    <SolidColorBrush x:Key="Brush.Error.Background" Color="#3A1C19"/>
    <SolidColorBrush x:Key="Brush.Error.Text"       Color="#FF9A8F"/>

    <!-- The keyboard-focus ring, in place of WPF's dotted black one, which vanishes on lacquer. -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="4" RadiusY="4" SnapsToDevicePixels="True"
                               Stroke="{StaticResource Brush.Focus}" StrokeThickness="1.5"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= MIDI / log =================
         The settings dot speaks like the title bar's chip: quiet when connected, an ivory
         flicker as notes arrive. The log is data, so it reads as quiet ivory, not terminal green
         (green means a note you hit). -->
    <SolidColorBrush x:Key="Brush.Midi.Idle"      Color="{StaticResource Color.Ivory.Disabled}"/>
    <SolidColorBrush x:Key="Brush.Midi.Connected" Color="{StaticResource Color.Ivory.Muted}"/>
    <SolidColorBrush x:Key="Brush.Midi.Active"    Color="{StaticResource Color.Ivory.Key}"/>
    <SolidColorBrush x:Key="Brush.Log.Text"       Color="{StaticResource Color.Ivory.Tertiary}"/>

    <!-- ================= Setup and status =================
         Amber marks what needs you: the title bar's status chip while the keyboard or audio
         isn't ready, and the next step of the first-run checklist. Whatever is fine stays a
         quiet grey. -->
    <SolidColorBrush x:Key="Brush.Attention"           Color="{StaticResource Color.Amber}"/>
    <SolidColorBrush x:Key="Brush.Attention.Ink"       Color="{StaticResource Color.Amber.Ink}"/>
    <SolidColorBrush x:Key="Brush.Attention.Border"    Color="{StaticResource Color.Amber.Border}"/>
    <SolidColorBrush x:Key="Brush.Attention.Fill"      Color="{StaticResource Color.Amber.Fill}"/>   <!-- on the title bar -->
    <SolidColorBrush x:Key="Brush.Attention.Wash"      Color="{StaticResource Color.Amber.Wash}"/>   <!-- on the stage -->
    <SolidColorBrush x:Key="Brush.Attention.WashHover" Color="{StaticResource Color.Amber.WashHover}"/>
    <SolidColorBrush x:Key="Brush.Stage.Hover"         Color="{StaticResource Color.Lacquer.Hover}"/>
    <!-- The status chip's dot while all is well: K's green status LED, a panel light like the
         halos', not a "you hit it". -->
    <SolidColorBrush x:Key="Brush.Status.Ok"           Color="#5DFF7A"/>
    <SolidColorBrush x:Key="Brush.Status.Activity"     Color="{StaticResource Color.Ivory.Key}"/>   <!-- a note played -->

    <!-- The title bar's status chip (DataContext: MainViewModel). Never focusable: a focused
         button would claim Space, the save-chord shortcut. The colours are all Setters, since
         a local value would outrank the triggers. -->
    <Style x:Key="Style.StatusChip" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="8,0,10,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <!-- No pill outline at rest: on the panel it reads as a printed status light, as on the
             comp. The attention state still draws its amber outline. -->
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="11"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            </Trigger>
            <DataTrigger Binding="{Binding StatusNeedsAttention}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Attention.Fill}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Attention.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Attention}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding StatusNeedsAttention}" Value="True"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.Attention.Wash}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The chip's dot: grey while all is well, amber while something isn't, and a flash of
         ivory with each note played. -->
    <Style x:Key="Style.StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="Fill" Value="{StaticResource Brush.Status.Ok}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusNeedsAttention}" Value="True">
                <Setter Property="Fill" Value="{StaticResource Brush.Attention}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyActivity}" Value="True">
                <Setter Property="Fill" Value="{StaticResource Brush.Status.Activity}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- One step of the setup checklist (DataContext: SetupStep). A row button: flat until
         hovered, except the next step to do, which sits on an amber wash. Not focusable, for
         Space's sake, like the chip. -->
    <Style x:Key="Style.SetupStep" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="6,0,12,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Stage.Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            </Trigger>
            <DataTrigger Binding="{Binding State}" Value="Next">
                <Setter Property="Background" Value="{StaticResource Brush.Attention.Wash}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding State}" Value="Next"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.Attention.WashHover}"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Done">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A quiet text button under or beside the checklist: "Settings", "Don't show again". -->
    <Style x:Key="Style.SetupLink" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Stage.Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Metronome beat light =================
         The light sits inside the metronome toggle, which is ivory while it is on, so the lit
         states are dark ink on ivory: a grey dot on, a black flash per beat, deep amber on the
         downbeat. Off, it is a hollow ring on lacquer. -->
    <SolidColorBrush x:Key="Brush.Metronome.Off"    Color="{StaticResource Color.Ivory.Muted}"/>
    <SolidColorBrush x:Key="Brush.Metronome.On"     Color="{StaticResource Color.Ivory.Faint}"/>
    <SolidColorBrush x:Key="Brush.Metronome.Beat"   Color="{StaticResource Color.Ink}"/>
    <SolidColorBrush x:Key="Brush.Metronome.Accent" Color="{StaticResource Color.Amber.Deep}"/>

    <!-- ================= Circle of fifths =================
         Inlaid in the stage: the segments are a step darker than it, like ebony set into the
         case. The selected key is amber, echoing the keyboard's tonic fill; its neighbours and
         relative take a faint wash of the same. The chord-root outline is the held-key blue,
         since it follows what is being played. -->
    <SolidColorBrush x:Key="Brush.Circle.Major"      Color="{StaticResource Color.Lacquer.Raised}"/>
    <SolidColorBrush x:Key="Brush.Circle.Minor"      Color="{StaticResource Color.Lacquer.Deep}"/>
    <!-- As on the K comp: the selected key is the white wedge with ink, its neighbours a mid
         grey, the chord's root a white outline. -->
    <SolidColorBrush x:Key="Brush.Circle.Related"    Color="#555555"/>
    <SolidColorBrush x:Key="Brush.Circle.Selected"   Color="{StaticResource Color.Ivory.Primary}"/>
    <SolidColorBrush x:Key="Brush.Circle.SelectedText" Color="{StaticResource Color.Ink}"/>
    <SolidColorBrush x:Key="Brush.Circle.Hover"      Color="{StaticResource Color.Ivory.Muted}"/>
    <SolidColorBrush x:Key="Brush.Circle.RootMarker" Color="{StaticResource Color.Ivory.Primary}"/>

    <!-- ================= Grand staff =================
         Lines recede, the clefs and key signature sit a step forward, and the notes you are
         holding are full ivory like the chord name, so the eye goes straight to them. -->
    <SolidColorBrush x:Key="Brush.Staff.Line"   Color="{StaticResource Color.Ivory.Faint}"/>
    <SolidColorBrush x:Key="Brush.Staff.Symbol" Color="{StaticResource Color.Ivory.Tertiary}"/>
    <SolidColorBrush x:Key="Brush.Staff.Note"   Color="{StaticResource Color.Ivory.Primary}"/>

    <!-- ================= Keyboard =================
         Ivory keytops and ebony sharps, with the meanings from the palette's colour table:
           blue    = a key you are holding; a paler blue while the pedal holds it
           amber   = the selected key: full on the tonic, a wash on the other white keys in it,
                     and an edge mark wherever a fill can't show it (black keys, held keys)
           magenta = the app asking for a key (a chord to try, the song's next notes)
         Every label brush is paired with the fill it sits on: idle labels clear 4.5:1 on ivory,
         the in-key wash and the tonic's darkest edge; the held pair clears 4.5:1 on its fill. -->

    <!-- Neutral white keytops, as on the front-panel concept: no ivory yellowing. -->
    <LinearGradientBrush x:Key="Brush.Key.White" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EDEDEB" Offset="0"/>
        <GradientStop Color="{StaticResource Color.Ivory.Key}" Offset="0.14"/>
        <GradientStop Color="#F6F6F4" Offset="0.88"/>
        <GradientStop Color="#E2E2DF" Offset="1"/>
    </LinearGradientBrush>
    <!-- Held: the key goes down (a darker, shaded white) and its back edge lights blue, the
         way a key-light strip does on hardware, so it reads from arm's length. -->
    <LinearGradientBrush x:Key="Brush.Key.White.Held" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.Blue}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.Blue}" Offset="0.045"/>
        <GradientStop Color="#A3A8AE" Offset="0.05"/>
        <GradientStop Color="#CFD0D1" Offset="0.16"/>
        <GradientStop Color="#DEDFDF" Offset="0.8"/>
        <GradientStop Color="#C8C9CA" Offset="1"/>
    </LinearGradientBrush>
    <!-- A key the sustain pedal holds after you let go: back up, its edge a quieter blue. Lit,
         since it is sounding, but plainly not under a finger. -->
    <LinearGradientBrush x:Key="Brush.Key.White.Ringing" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#9CC8F2" Offset="0"/>
        <GradientStop Color="#9CC8F2" Offset="0.035"/>
        <GradientStop Color="{StaticResource Color.Ivory.Key}" Offset="0.04"/>
        <GradientStop Color="#E6E6E3" Offset="1"/>
    </LinearGradientBrush>
    <!-- In the key but not its tonic: no wash at all, so the keyboard stays white (in C major
         every white key is in the key). The amber front lip below carries the role. -->
    <LinearGradientBrush x:Key="Brush.Key.White.InKey" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EDEDEB" Offset="0"/>
        <GradientStop Color="{StaticResource Color.Ivory.Key}" Offset="0.14"/>
        <GradientStop Color="#F6F6F4" Offset="0.88"/>
        <GradientStop Color="#E2E2DF" Offset="1"/>
    </LinearGradientBrush>
    <!-- The tonic: plain white like every key; its thick dark front lip marks it. -->
    <LinearGradientBrush x:Key="Brush.Key.White.Tonic" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EDEDEB" Offset="0"/>
        <GradientStop Color="{StaticResource Color.Ivory.Key}" Offset="0.14"/>
        <GradientStop Color="#F6F6F4" Offset="0.88"/>
        <GradientStop Color="#E2E2DF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Key.White.Border" Color="#2A2622"/>

    <!-- Ebony sharps share one bevel: a lit lacquer edge, a fast falloff, then a slow darkening. -->
    <LinearGradientBrush x:Key="Brush.Key.Black" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A4540" Offset="0"/>
        <GradientStop Color="#25221F" Offset="0.08"/>
        <GradientStop Color="#181614" Offset="0.5"/>
        <GradientStop Color="{StaticResource Color.Lacquer.Deep}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Key.Black.Held" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.Blue}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.Blue}" Offset="0.06"/>
        <GradientStop Color="#0A0908" Offset="0.07"/>
        <GradientStop Color="#141210" Offset="0.6"/>
        <GradientStop Color="#221F1C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Key.Black.Ringing" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6E9CCB" Offset="0"/>
        <GradientStop Color="#6E9CCB" Offset="0.05"/>
        <GradientStop Color="#25221F" Offset="0.06"/>
        <GradientStop Color="#181614" Offset="0.5"/>
        <GradientStop Color="{StaticResource Color.Lacquer.Deep}" Offset="1"/>
    </LinearGradientBrush>
    <!-- The tonic keeps a body colour on black keys too; the other in-key black keys get only
         the edge mark, so a scale doesn't turn half the black keys into coloured slabs. -->
    <LinearGradientBrush x:Key="Brush.Key.Black.Tonic" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A4540" Offset="0"/>
        <GradientStop Color="#25221F" Offset="0.08"/>
        <GradientStop Color="#181614" Offset="0.5"/>
        <GradientStop Color="{StaticResource Color.Lacquer.Deep}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Key.Black.Border" Color="#050404"/>

    <!-- Edge marks, so a key's role never rests on colour alone: the top edge of an in-key
         black key, and the front lip of every in-key white key. On ebony or a held key the mark
         is light; on an unheld white key it is a dark amber lip against the wash. The tonic's
         mark is stronger and thicker. -->
    <!-- Neutral, not amber: the keys stay black and white. Light marks on ebony and held keys,
         dark ones on white; the tonic's mark is the strongest and thickest. The lip on a white
         key clears 3:1 against it. -->
    <SolidColorBrush x:Key="Brush.Key.InKey.Mark"       Color="#9A9A98"/>
    <SolidColorBrush x:Key="Brush.Key.Tonic.Mark"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Key.InKey.Mark.Ivory" Color="#8E8E8A"/>
    <SolidColorBrush x:Key="Brush.Key.Tonic.Mark.Ivory" Color="#2E2E2E"/>

    <!-- Hint outline and dot, with a deep keyline inside so the outline still separates from
         a light fill (ivory, amber, held blue) whose brightness is close to the magenta's. -->
    <SolidColorBrush x:Key="Brush.Key.Hint"         Color="{StaticResource Color.Target}"/>
    <SolidColorBrush x:Key="Brush.Key.Hint.Keyline" Color="#3D0A24"/>

    <!-- Labels. Idle keys show only the Cs (every key with "All note names"); a held key's
         label switches to the held pair, spelled for the selected key. -->
    <SolidColorBrush x:Key="Brush.Key.Label"            Color="#47423B"/>
    <SolidColorBrush x:Key="Brush.Key.Label.Held"       Color="#2A2620"/>
    <SolidColorBrush x:Key="Brush.Key.Black.Label"      Color="#9A948A"/>
    <SolidColorBrush x:Key="Brush.Key.Black.Label.Held" Color="#C8D9EC"/>

    <!-- ================= Song practice (falling notes) =================
         The lane is a piano roll: notes are flat slots cut in a deep lacquer well, bar numbers
         sit in its margin, and the keys' top edge is the tracker bar every note is read against.
         Your two hands take hues used nowhere else: teal right, violet left, so a note landing
         never reads as your own held (blue) key, as correct (green), or as the key (amber).
         Other parts are accompaniment: quiet neutrals of different warmth and lightness, so
         colour always means your hands. Auto-play notes are drawn translucent by the view. -->
    <SolidColorBrush x:Key="Brush.Song.Lane"        Color="{StaticResource Color.Lacquer.Deep}"/>
    <SolidColorBrush x:Key="Brush.Song.OctaveLine"  Color="{StaticResource Color.Lacquer.Raised}"/>
    <SolidColorBrush x:Key="Brush.Song.GroupLine"   Color="{StaticResource Color.Lacquer.Stage}"/>
    <SolidColorBrush x:Key="Brush.Song.BarLine"     Color="{StaticResource Color.Lacquer.Hover}"/>
    <SolidColorBrush x:Key="Brush.Song.BarNumber"   Color="{StaticResource Color.Ivory.Muted}"/>
    <SolidColorBrush x:Key="Brush.Song.HitLine"     Color="{StaticResource Color.Ivory.Tertiary}"/>
    <SolidColorBrush x:Key="Brush.Song.Sounding"    Color="{StaticResource Color.Ivory.Key}"/>
    <!-- A loop is a range you set: ivory, since it is neither the key nor waiting on you. -->
    <SolidColorBrush x:Key="Brush.Song.Loop"        Color="{StaticResource Color.Ivory.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Song.OutsideLoop" Color="#8C000000"/>
    <SolidColorBrush x:Key="Brush.Song.Folded"      Color="{StaticResource Color.Ivory.Primary}"/>
    <!-- The chord wait mode is holding for: the keyboard's hint magenta, so note and key match. -->
    <SolidColorBrush x:Key="Brush.Song.Target"      Color="{StaticResource Color.Target}"/>
    <!-- Green is "you hit it" and nothing else; red is its opposite. -->
    <SolidColorBrush x:Key="Brush.Song.Correct"     Color="{StaticResource Color.Correct}"/>
    <SolidColorBrush x:Key="Brush.Song.Wrong"       Color="{StaticResource Color.Wrong}"/>
    <SolidColorBrush x:Key="Brush.Song.Overlay"     Color="#CC100F0E"/>

    <!-- ================= Recorder =================
         A take is a small roll too, in the same deep well: your notes in the held-key blue,
         since you played them, the A-B loop as a faint ivory range like the song's, and a
         brighter, thicker ivory playhead.
         Record is red by convention: dull while idle, bright while armed or recording. -->
    <SolidColorBrush x:Key="Brush.Timeline.Background" Color="{StaticResource Color.Lacquer.Deep}"/>
    <SolidColorBrush x:Key="Brush.Timeline.Note"       Color="{StaticResource Color.Blue}"/>
    <SolidColorBrush x:Key="Brush.Timeline.Region"     Color="{StaticResource Color.Ivory.Primary}" Opacity="0.1"/>
    <SolidColorBrush x:Key="Brush.Timeline.RegionEdge" Color="{StaticResource Color.Ivory.Tertiary}"/>
    <SolidColorBrush x:Key="Brush.Timeline.Playhead"   Color="{StaticResource Color.Ivory.Key}"/>
    <SolidColorBrush x:Key="Brush.Timeline.SecondLine" Color="{StaticResource Color.Lacquer.Raised}"/>
    <SolidColorBrush x:Key="Brush.Timeline.Hint"       Color="{StaticResource Color.Ivory.Muted}"/>
    <SolidColorBrush x:Key="Brush.Record.Idle"         Color="{StaticResource Color.Record.Idle}"/>
    <SolidColorBrush x:Key="Brush.Record.Active"       Color="{StaticResource Color.Record}"/>
    <SolidColorBrush x:Key="Brush.Song.Part0"       Color="#3FC1B0"/>   <!-- right hand: teal -->
    <SolidColorBrush x:Key="Brush.Song.Part1"       Color="#B39DDB"/>   <!-- left hand: violet -->
    <SolidColorBrush x:Key="Brush.Song.Part2"       Color="#C8BCA9"/>   <!-- accompaniment: stone -->
    <SolidColorBrush x:Key="Brush.Song.Part3"       Color="#9FA2A5"/>   <!-- accompaniment: pewter -->
    <SolidColorBrush x:Key="Brush.Song.Part4"       Color="#95796D"/>   <!-- accompaniment: clay -->
    <SolidColorBrush x:Key="Brush.Song.Part5"       Color="#68686F"/>   <!-- accompaniment: graphite -->

    <!-- ================= Roman numerals =================
         Every numeral is ivory like the chord name above it, whatever its kind: a hue here
         would borrow one that already means your hands, a hit or a miss. A chord from
         outside the key names its kind in a small muted tag on the readout, and in the
         numeral's tooltip everywhere. -->

    <!-- For a Run whose DataContext has Function and FunctionKind: ChordAnalysis, SavedChord. -->
    <Style x:Key="Style.Function.Numeral" TargetType="Run">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="ToolTip" Value="Roman numeral in the selected key"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding FunctionKind}" Value="SecondaryDominant">
                <Setter Property="ToolTip" Value="Secondary dominant: the V or vii° of the chord after the slash"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FunctionKind}" Value="Borrowed">
                <Setter Property="ToolTip" Value="Borrowed from the parallel major or minor"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FunctionKind}" Value="Chromatic">
                <Setter Property="ToolTip" Value="Chromatic: outside the key and its parallel major and minor"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The kind in words after a non-diatonic numeral. Text comes only from here; the last
         trigger blanks it while there is no numeral to label. -->
    <Style x:Key="Style.Function.Tag" TargetType="Run">
        <Setter Property="Text" Value=""/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding FunctionKind}" Value="SecondaryDominant">
                <Setter Property="Text" Value=" secondary"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FunctionKind}" Value="Borrowed">
                <Setter Property="Text" Value=" borrowed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FunctionKind}" Value="Chromatic">
                <Setter Property="Text" Value=" chromatic"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Function}" Value="">
                <Setter Property="Text" Value=""/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- K's numeral pill on the readout: a white key with ink. -->
    <SolidColorBrush x:Key="Brush.Readout.Pill"    Color="{StaticResource Color.Ivory.Primary}"/>
    <SolidColorBrush x:Key="Brush.Readout.PillInk" Color="{StaticResource Color.Ink}"/>

    <!-- The numeral in the pill (DataContext: ChordAnalysis), with the same tooltips as the run. -->
    <Style x:Key="Style.Function.NumeralPill" TargetType="TextBlock">
        <Setter Property="ToolTip" Value="Roman numeral in the selected key"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding FunctionKind}" Value="SecondaryDominant">
                <Setter Property="ToolTip" Value="Secondary dominant: the V or vii° of the chord after the slash"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FunctionKind}" Value="Borrowed">
                <Setter Property="ToolTip" Value="Borrowed from the parallel major or minor"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FunctionKind}" Value="Chromatic">
                <Setter Property="ToolTip" Value="Chromatic: outside the key and its parallel major and minor"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Between the kind word and the voicing, only while there is a kind word. -->
    <Style x:Key="Style.Function.TagGap" TargetType="Run">
        <Setter Property="Text" Value=""/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Faint}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding FunctionKind}" Value="SecondaryDominant">
                <Setter Property="Text" Value=" · "/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FunctionKind}" Value="Borrowed">
                <Setter Property="Text" Value=" · "/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FunctionKind}" Value="Chromatic">
                <Setter Property="Text" Value=" · "/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Function}" Value="">
                <Setter Property="Text" Value=""/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Between the numeral and the voicing on the readout (DataContext: ChordAnalysis), only
         while both are showing. The dot matches the one inside the voicing text. -->
    <Style x:Key="Style.Function.VoicingSeparator" TargetType="Run">
        <Setter Property="Text" Value=" · "/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Faint}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Function}" Value="">
                <Setter Property="Text" Value=""/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Voicing}" Value="">
                <Setter Property="Text" Value=""/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Diatonic chord strip =================
         Borderless lacquer tiles at rest. The one matching what's held gains an edge in the
         held-key blue (the only edged tile, so it reads without the hue too), and a hovered
         tile's outline is the keyboard's hint magenta, tying it to the markers it draws on the
         keys. -->
    <SolidColorBrush x:Key="Brush.ChordTile"              Color="{StaticResource Color.Lacquer.Raised}"/>
    <SolidColorBrush x:Key="Brush.ChordTile.Border"       Color="{StaticResource Color.Lacquer.Raised}"/>
    <SolidColorBrush x:Key="Brush.ChordTile.Hover"        Color="{StaticResource Color.Lacquer.Hover}"/>
    <SolidColorBrush x:Key="Brush.ChordTile.Hint"         Color="{StaticResource Color.Target}"/>
    <SolidColorBrush x:Key="Brush.ChordTile.Played"       Color="{StaticResource Color.Ivory.Primary}"/>
    <SolidColorBrush x:Key="Brush.ChordTile.PlayedBorder" Color="{StaticResource Color.Ivory.Primary}"/>
    <SolidColorBrush x:Key="Brush.ChordTile.PlayedInk"    Color="{StaticResource Color.Ink}"/>

    <!-- ================= Front panel keys =================
         Black rubber keys on the scarlet panel, each with an LED bar set into its top edge.
         The LED is the key's content (Style.PanelLed and a lit variant per key in MainWindow),
         so a key's state shows on the key. Never focusable: a focused key would take Space. -->
    <LinearGradientBrush x:Key="Brush.PanelKey" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C2C2C" Offset="0"/>
        <GradientStop Color="#121212" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PanelKey.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A3A3A" Offset="0"/>
        <GradientStop Color="#1A1A1A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.PanelKey.Shadow" Color="#000000"/>
    <SolidColorBrush x:Key="Brush.PanelKey.Highlight" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Led.Off"   Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.Led.White" Color="#FFFFFF"/>
    <!-- The save key's light, green as on the comp: a panel light, like the halos'. -->
    <SolidColorBrush x:Key="Brush.Led.Green" Color="#5DFF7A"/>

    <Style x:Key="Style.PanelKey" TargetType="ButtonBase">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="{StaticResource Brush.PanelKey}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <!-- The key's skirt: a 2px black edge below it, the shadow it casts. -->
                        <Border CornerRadius="5" Background="{StaticResource Brush.PanelKey.Shadow}" Margin="0,2,0,-2"/>
                        <Border x:Name="Cap" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Brush.PanelKey.Highlight}" BorderThickness="0,1,0,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.PanelKey.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Cap" Property="Margin" Value="0,1,0,-1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Cap" Property="Opacity" Value="0.55"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A key's LED, unlit. Each key in MainWindow lights it with its own trigger. -->
    <Style x:Key="Style.PanelLed" TargetType="Rectangle">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="RadiusX" Value="1.5"/>
        <Setter Property="RadiusY" Value="1.5"/>
        <Setter Property="Fill" Value="{StaticResource Brush.Led.Off}"/>
    </Style>
    <DropShadowEffect x:Key="Effect.Led" x:Shared="False" ShadowDepth="0" BlurRadius="6" Opacity="0.9"
                      Color="{StaticResource Color.Ivory.Primary}"/>

    <!-- The legend printed under a panel key. -->
    <Style x:Key="Style.PanelLegend" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <!-- The physical key under a soft key's label: 16px of black rubber, 18px below it. -->
    <Style x:Key="Style.SoftKeyCap" TargetType="Border">
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="3,18,3,0"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Background" Value="{StaticResource Brush.PanelKey}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelKey.Highlight}"/>
        <Setter Property="BorderThickness" Value="0,1,0,2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- The 7ths switch as a soft key, to sit in the chord strip's row of keys: a black label
         while off, a white one with ink while on. -->
    <Style x:Key="Style.SoftKeyToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource Brush.ChordTile}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Background="Transparent">
                        <Border Height="22" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Key" Style="{StaticResource Style.SoftKeyCap}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.ChordTile.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Text.Primary}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Key" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A chord tile (DataContext: ChordTileViewModel), drawn as a soft key: its 22px label sits
         on the OLED's bottom edge and a black rubber key sits under it on the panel, 18px lower,
         past the window's bezel (see Size.SoftKey.* and the OLED window's bottom margin in
         MainWindow). The whole column is one button. Never focusable, or a clicked tile would
         take Space, the save-chord shortcut. All the colours are Setters, since a local value
         would outrank the triggers. -->
    <Style x:Key="Style.ChordTile" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinWidth" Value="52"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource Brush.ChordTile}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.ChordTile.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Background="Transparent">
                        <Border Height="22" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Key" Style="{StaticResource Style.SoftKeyCap}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Key" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.ChordTile.Hover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.ChordTile.Hint}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsPlayed}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.ChordTile.Played}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.ChordTile.PlayedBorder}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.ChordTile.PlayedInk}"/>
            </DataTrigger>
            <!-- Played and hovered: the hint outline takes over the blue edge. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPlayed}" Value="True"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.ChordTile.Hint}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Readout type scale ================= -->
    <sys:Double x:Key="Size.Readout.Name">72</sys:Double>
    <sys:Double x:Key="Size.Readout.Voicing">14</sys:Double>
    <!-- Sized to share the voicing line's 19px block line box without growing it -->
    <sys:Double x:Key="Size.Readout.Function">18</sys:Double>
    <sys:Double x:Key="Size.Readout.Notes">18</sys:Double>
    <sys:Double x:Key="Size.Readout.Intervals">14</sys:Double>

    <!-- =========================================================================
         Menu. The stock WPF MenuItem template is light-themed, and setting only
         Foreground/Background leaves the dropdown popup light on a dark title bar,
         so the templates have to be replaced outright.
         ========================================================================= -->

    <!-- A top-level header such as "View" — this is where the dropdown popup lives. -->
    <ControlTemplate x:Key="Menu.TopLevelHeader" TargetType="MenuItem">
        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}" CornerRadius="3">
            <Grid>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center"/>
                <!-- AllowsTransparency stays False: a transparent popup layered over an
                     AllowsTransparency window softens text on some GPUs. -->
                <Popup x:Name="PART_Popup" AllowsTransparency="False" Focusable="False"
                       IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom"
                       PopupAnimation="None" VerticalOffset="4" HorizontalOffset="-8">
                    <Border Background="{StaticResource Brush.Popup.Background}"
                            BorderBrush="{StaticResource Brush.Popup.Border}" BorderThickness="1"
                            Padding="0,4" MinWidth="200">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A top-level item with no submenu. -->
    <ControlTemplate x:Key="Menu.TopLevelItem" TargetType="MenuItem">
        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}" CornerRadius="3">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                              VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A leaf item inside a dropdown: check column, header, right-aligned gesture text. -->
    <ControlTemplate x:Key="Menu.SubmenuItem" TargetType="MenuItem">
        <Border x:Name="Bg" Background="Transparent" Padding="0,6" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path x:Name="Check" Grid.Column="0" Visibility="Collapsed"
                      Data="M 0,4.5 L 3.4,8 L 9,1"
                      Stroke="{StaticResource Brush.Text.Primary}" StrokeThickness="1.6"
                      StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center"/>

                <TextBlock x:Name="Gesture" Grid.Column="2"
                           Text="{TemplateBinding InputGestureText}"
                           Foreground="{StaticResource Brush.Text.Faint}" FontSize="11"
                           VerticalAlignment="Center" Margin="28,0,14,0"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
                <Setter TargetName="Gesture" Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A nested submenu header: same row, plus an arrow and a side-placed popup. -->
    <ControlTemplate x:Key="Menu.SubmenuHeader" TargetType="MenuItem">
        <Border x:Name="Bg" Background="Transparent" Padding="0,6" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center"/>

                <Path Grid.Column="2" Data="M 0,0 L 4,4 L 0,8" Margin="28,0,10,0"
                      Stroke="{StaticResource Brush.Text.Muted}" StrokeThickness="1.4"
                      VerticalAlignment="Center"/>

                <Popup x:Name="PART_Popup" AllowsTransparency="False" Focusable="False"
                       IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right"
                       PopupAnimation="None" HorizontalOffset="-2">
                    <Border Background="{StaticResource Brush.Popup.Background}"
                            BorderBrush="{StaticResource Brush.Popup.Border}" BorderThickness="1"
                            Padding="0,4" MinWidth="180">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template" Value="{StaticResource Menu.SubmenuItem}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource Menu.TopLevelHeader}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource Menu.TopLevelItem}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource Menu.SubmenuHeader}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Keyed off MenuItem.SeparatorStyleKey so it only affects separators inside menus. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="26,4,8,4"/>
        <Setter Property="Background" Value="{StaticResource Brush.Separator}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <StackPanel IsItemsHost="True" Orientation="Horizontal"
                                Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================
         Input controls. The settings panel is now a focal overlay, so its stock
         light-chrome controls have to be darkened to match.
         Note: a local <Button.Style> without BasedOn replaces these outright.
         ========================================================================= -->

    <!-- Ink, not boxes: a lacquer key with no border at rest. The border stays 1px and
         transparent so a style that does draw one keeps the same size. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Stage}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Disabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one primary action in a view ("Start audio", "Send", "Play again"): an ivory key,
         like a control that is switched on. -->
    <Style x:Key="Style.PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brush.On}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.On.Ink}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.On.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Text.Secondary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Disabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scrollbars: a lacquer thumb in a clear track, not the stock light chrome (the MIDI log,
         chat and take list all scroll). Both orientations; the track still pages on click, and
         shows as a faint strip under the pointer so the scroll area can be found. -->
    <Style x:Key="Style.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{StaticResource Brush.ScrollThumb}" CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Text.Muted}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Text.Tertiary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Style.Resources>
            <!-- Track keeps the thumb at least half a scroll button long, and there are no
                 buttons here, so these set that floor: a 24px thumb even on a long log, instead
                 of a stray dot. -->
            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">48</sys:Double>
            <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">48</sys:Double>
        </Style.Resources>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}" Padding="1">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Style.ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Style.ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Style.ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}" Padding="1">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Style.ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Style.ScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Style.ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Input}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Brush.Input}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Brush.Input}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- A zero-opacity ToggleButton covering the whole control is the standard
                             way to keep click-to-open without theming the stock button chrome. -->
                        <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{StaticResource Brush.Input}"
                                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="3" SnapsToDevicePixels="True">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,9,0" Data="M 0,0 L 4,4 L 8,0"
                                              Stroke="{StaticResource Brush.Text.Muted}" StrokeThickness="1.4"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{StaticResource Brush.Text.Muted}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <!-- What an empty selection reads as, taken from Tag: the key picker's
                             "No key". Tag rather than a new property, so any ComboBox can opt
                             in with one attribute; without a Tag it stays blank as before. -->
                        <TextBlock x:Name="Placeholder" Visibility="Collapsed" IsHitTestVisible="False"
                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"
                                   Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <Popup x:Name="PART_Popup" AllowsTransparency="False" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               PopupAnimation="None"
                               MinWidth="{TemplateBinding ActualWidth}">
                            <Border Background="{StaticResource Brush.Popup.Background}"
                                    BorderBrush="{StaticResource Brush.Popup.Border}" BorderThickness="1"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <!-- ItemsPresenter, not a bare IsItemsHost panel: grouping (the
                                     scale picker's section headers) generates each group's items
                                     through it, and without it every group renders empty. The
                                     default ItemsPanel is still a StackPanel. -->
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
                        </Trigger>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chromeless buttons. Background/Foreground are Setters, not attributes on the element:
         a local value outranks a Style trigger, so an inline Background="Transparent" would
         stop the hover highlight from ever painting. -->
    <ControlTemplate x:Key="Template.FlatButton" TargetType="Button">
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </ControlTemplate>

    <Style x:Key="Style.TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Template" Value="{StaticResource Template.FlatButton}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Style.TitleBarClose" TargetType="Button" BasedOn="{StaticResource Style.TitleBarButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Danger}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small transparent text button, e.g. Clear in Piano controls. Glyphs use the one below. -->
    <Style x:Key="Style.IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource Template.FlatButton}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Danger.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A glyph from Font.Icon: close, clear, refresh, export. Hover brightens it; only removing
         something (a saved chord, a take) earns the red of Style.RemoveGlyphButton. -->
    <Style x:Key="Style.GlyphButton" TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Style.RemoveGlyphButton" TargetType="Button" BasedOn="{StaticResource Style.GlyphButton}">
        <Setter Property="Content" Value="&#xE711;"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Danger.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A button that stays down while its feature is on, e.g. the metronome: a lacquer key
         at rest, an ivory one while on. Keyed rather than implicit so the ComboBox's internal
         ToggleButton is unaffected. -->
    <Style x:Key="Style.ToolbarToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.On}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.On.Ink}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.On.Hover}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource Brush.Border}" StrokeThickness="1.4"
                                     Fill="{StaticResource Brush.Input}"/>
                            <Ellipse x:Name="Dot" Width="6" Height="6" Visibility="Collapsed"
                                     Fill="{StaticResource Brush.Text.Primary}"/>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Text.Muted}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Text.Muted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mirrors the RadioButton above: a square box with a tick instead of a ring with a dot.
         Without this the stock CheckBox chrome renders light against the dark stage. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="14" Height="14" CornerRadius="3"
                                VerticalAlignment="Center" Margin="0,0,6,0"
                                Background="{StaticResource Brush.Input}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1.4">
                            <Path x:Name="Tick" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0,3 L 2.6,5.6 L 7,0.6"
                                  Stroke="{StaticResource Brush.Text.Primary}" StrokeThickness="1.6"
                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Text.Muted}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Text.Muted}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
                            <Setter TargetName="Tick" Property="Stroke" Value="{StaticResource Brush.Text.Disabled}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================
         Playing from the piano: the chord latch, the echo, MIDI learn. The keys the sustain
         pedal holds live with the other key fills, as Brush.Key.*.Ringing. Learn listens in
         amber, the key-centre hue, because it is the app waiting on the piano; a learned
         control firing flashes the held blue, because a press did it.
         ========================================================================= -->
    <SolidColorBrush x:Key="Brush.Learn.Chip"      Color="{StaticResource Color.Lacquer.Raised}"/>
    <SolidColorBrush x:Key="Brush.Learn.Listening" Color="{StaticResource Color.Amber.Strong}"/>
    <SolidColorBrush x:Key="Brush.Learn.Fired"     Color="{StaticResource Color.Blue}"/>
    <SolidColorBrush x:Key="Brush.Learn.FiredFill" Color="{StaticResource Color.Lacquer.Raised}"/>

    <SolidColorBrush x:Key="Brush.Echo.Background" Color="#F21C1C1C"/>   <!-- Color.Lacquer.Raised at 95% -->
    <SolidColorBrush x:Key="Brush.Echo.Border"     Color="{StaticResource Color.Lacquer.Line}"/>
    <SolidColorBrush x:Key="Brush.Echo.Text"       Color="{StaticResource Color.Ivory.Primary}"/>

    <!-- The chord readout's lines and the grand staff while latched: full strength for a beat,
         then dimming fast and settling, so a held-over chord reads as a memory rather than as
         what is sounding. Out by 2 s, MainViewModel.LatchDuration, when the view model clears
         the text; unlatching removes the fade in the same instant. Bound through the window,
         since the readout's voicing line has the analysis as its own DataContext. -->
    <Style x:Key="Style.Readout.Latch" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsReadoutLatched,
                                   RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="ReadoutLatchFade">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="0.4">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <ExponentialEase EasingMode="EaseOut" Exponent="4"/>
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                                <LinearDoubleKeyFrame KeyTime="0:0:2" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="ReadoutLatchFade"/>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The echo: a few words over the top of the stage on what a control on the piano just
         did, since the toolbar and status bar that would show it may be hidden (zen mode).
         Out of the layout and never hit-testable, so it cannot move or cover anything you
         click. MainWindow fades it in and out; it rests invisible. -->
    <Style x:Key="Style.PianoEcho" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
        <Setter Property="Padding" Value="14,5,14,6"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{StaticResource Brush.Echo.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Echo.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource Color.Shadow}" Direction="270"
                                  ShadowDepth="3" BlurRadius="14" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
