<UserControl x:Class="PianoMidiVisualizationApp.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource Brush.TitleBar}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (always visible) -->
            <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" Padding="10,6" Cursor="Hand"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <TextBlock Text="AI Music Assistant" Foreground="{StaticResource Brush.Text.Primary}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Clear" Padding="8,2" Margin="0,0,8,0"
                                Command="{Binding ClearHistoryCommand}"
                                Visibility="{Binding IsPanelExpanded, Converter={StaticResource BoolToVisConverter}}"
                                Background="{StaticResource Brush.Hover}" Foreground="{StaticResource Brush.Text.Tertiary}"
                                BorderThickness="0" FontSize="11"/>
                        <TextBlock Foreground="{StaticResource Brush.Text.Muted}" FontSize="14" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#x25BC;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPanelExpanded}" Value="True">
                                            <Setter Property="Text" Value="&#x25B2;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource Brush.Text.Faint}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="(Click to expand)"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPanelExpanded}" Value="True">
                                        <Setter Property="Text" Value=""/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                        <Setter Property="Text" Value="(Set API key in settings to enable)"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Content (collapsible) -->
            <Border Grid.Row="1" Height="220"
                    Visibility="{Binding IsPanelExpanded, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Message history -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" x:Name="MessagesScrollViewer"
                                  Background="{StaticResource Brush.Console}" Padding="8">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,6" Margin="4,2" MaxWidth="500">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox Text="{Binding Content, Mode=OneWay}" TextWrapping="Wrap"
                                                 Foreground="{StaticResource Brush.Text.Primary}" FontSize="13"
                                                 Background="Transparent" BorderThickness="0"
                                                 IsReadOnly="True" IsReadOnlyCaretVisible="False" Padding="0"
                                                 Cursor="Arrow"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Error message -->
                    <Border Grid.Row="1" Background="{StaticResource Brush.Error.Background}" Padding="8,4"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBox Text="{Binding ErrorMessage, Mode=OneWay}" Foreground="{StaticResource Brush.Error.Text}" FontSize="12"
                                 TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                 IsReadOnly="True" Cursor="IBeam" Padding="0"/>
                    </Border>

                    <!-- Input area -->
                    <Border Grid.Row="2" Background="{StaticResource Brush.InputArea}" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" x:Name="InputTextBox"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource Brush.Input}" Foreground="{StaticResource Brush.Text.Primary}"
                                     BorderThickness="1" BorderBrush="{StaticResource Brush.Border}" Padding="8,6" FontSize="13"
                                     VerticalContentAlignment="Center"
                                     KeyDown="InputTextBox_KeyDown">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <!-- Send button (shown when not loading) -->
                                <Button Content="Send" Padding="16,6"
                                        Command="{Binding SendCommand}"
                                        Background="{StaticResource Brush.Accent}" Foreground="{StaticResource Brush.Text.Primary}"
                                        BorderThickness="0" FontWeight="SemiBold">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Cancel button (shown when loading) -->
                                <Button Content="Cancel" Padding="16,6"
                                        Command="{Binding CancelCommand}"
                                        Background="{StaticResource Brush.Danger.Muted}" Foreground="{StaticResource Brush.Text.Primary}" BorderThickness="0"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
