<UserControl x:Class="PianoMidiVisualizationApp.Views.RecorderTransport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The recorder's slice of the practice toolbar: record, play/stop, loop, speed and a clock.
         DataContext is the RecorderViewModel. The buttons are Focusable="False" so that clicking
         one never leaves it holding focus: a focused button would take Space, which the window
         uses to save the current chord. (A focused ComboBox ignores Space, so it can keep focus.) -->
    <UserControl.Resources>
        <Style x:Key="Style.TransportButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="Brush.Record.Idle" Color="#A04A4A"/>
        <SolidColorBrush x:Key="Brush.Record.Active" Color="#FF4040"/>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <!-- Record. Idle: a dull red dot. Armed: an outlined dot that pulses until the first
             note starts the take. Recording: solid bright red. -->
        <Button Command="{Binding ToggleRecordCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Style.TransportButton}">
                    <Setter Property="ToolTip" Value="Record (Ctrl+R). Recording starts at your first note."/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RecordState}" Value="WaitingForFirstNote">
                            <Setter Property="ToolTip" Value="Armed: recording starts at your first note. Ctrl+R to cancel."/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RecordState}" Value="Recording">
                            <Setter Property="ToolTip" Value="Stop recording (Ctrl+R)"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Ellipse Width="11" Height="11" StrokeThickness="1.6">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{StaticResource Brush.Record.Idle}"/>
                        <Setter Property="Stroke" Value="{x:Null}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecordState}" Value="WaitingForFirstNote">
                                <Setter Property="Fill" Value="Transparent"/>
                                <Setter Property="Stroke" Value="{StaticResource Brush.Record.Active}"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="ArmedPulse">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.25" Duration="0:0:0.6"
                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="ArmedPulse"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RecordState}" Value="Recording">
                                <Setter Property="Fill" Value="{StaticResource Brush.Record.Active}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </Button>

        <!-- Play / stop the selected take, or the newest one -->
        <Button Margin="2,0,0,0" Command="{Binding TogglePlaybackCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Style.TransportButton}">
                    <Setter Property="ToolTip" Value="Play the selected take (Ctrl+Shift+R)"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter Property="ToolTip" Value="Stop playback (Ctrl+Shift+R)"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Grid>
                <Path Data="M 0,0 L 9,5.5 L 0,11 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <Rectangle Width="9" Height="9"
                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                           Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisConverter}}"/>
            </Grid>
        </Button>

        <!-- Loop: the A–B region if one is set, otherwise the whole take -->
        <ToggleButton Margin="2,0,0,0" IsChecked="{Binding IsLooping}"
                      Style="{StaticResource Style.TransportButton}"
                      ToolTip="Loop the take, or its A–B region">
            <TextBlock Text="&#xE8EE;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
        </ToggleButton>

        <ComboBox Width="64" Height="26" Margin="4,0,0,0"
                  ItemsSource="{Binding Speeds}"
                  SelectedValuePath="Factor"
                  SelectedValue="{Binding Speed}"
                  ToolTip="Playback speed">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Fixed width, so the bar does not shift as the digits change -->
        <TextBlock Text="{Binding ClockText}" Width="52" Margin="8,0,0,0"
                   FontFamily="Consolas" FontSize="12" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecordArmed}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Record.Active}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
