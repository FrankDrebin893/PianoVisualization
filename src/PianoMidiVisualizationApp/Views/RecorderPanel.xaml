<UserControl x:Class="PianoMidiVisualizationApp.Views.RecorderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PianoMidiVisualizationApp.Views">

    <!-- Takes on the left; the selected take's timeline and its A–B loop on the right.
         DataContext is the RecorderViewModel. -->
    <UserControl.Resources>
        <Style x:Key="Style.PanelButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Surface}" Height="150" Padding="8,6,8,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Takes ===== -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Brush.Text.Faint}" FontSize="10"
                               VerticalAlignment="Center"
                               Text="{Binding Takes.Count, StringFormat='{}{0}/10 kept'}"/>
                    <TextBlock Text="Recorder" Foreground="{StaticResource Brush.Text.Tertiary}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <Grid>
                    <!-- Neither the list nor its items take focus: a focused ListBox swallows Space
                         (it re-selects), and Space has to keep saving the chord. Clicks select via
                         TakeList_PreviewMouseLeftButtonDown instead. -->
                    <ListBox x:Name="TakeList" ItemsSource="{Binding Takes}" SelectedItem="{Binding SelectedTake}"
                             Background="{StaticResource Brush.Console}" BorderThickness="0"
                             Focusable="False"
                             PreviewMouseLeftButtonDown="TakeList_PreviewMouseLeftButtonDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" Padding="6,3">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding CreatedText, Mode=OneWay}" FontSize="10"
                                             Foreground="{StaticResource Brush.Text.Muted}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding LengthText}" FontFamily="Consolas"
                                               FontSize="12" VerticalAlignment="Center" Margin="8,0,4,0"
                                               ToolTip="{Binding Summary}"/>
                                    <Button Grid.Column="2" Content="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            Style="{StaticResource Style.IconButton}" Focusable="False"
                                            Command="{Binding DataContext.ExportTakeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center" ToolTip="Export as .mid"/>
                                    <Button Grid.Column="3" Content="✕" Focusable="False"
                                            Style="{StaticResource Style.IconButton}"
                                            Command="{Binding DataContext.DeleteTakeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center" ToolTip="Delete take"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state, over the list -->
                    <TextBlock Text="No takes yet. Press Ctrl+R, then play — recording starts at your first note."
                               TextWrapping="Wrap" TextAlignment="Center" Margin="12,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               FontSize="11" Foreground="{StaticResource Brush.Text.Faint}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Takes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <!-- ===== Selected take ===== -->
            <DockPanel Grid.Column="1" Margin="10,0,0,0">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Export .mid…" Style="{StaticResource Style.PanelButton}"
                            Command="{Binding ExportTakeCommand}"
                            IsEnabled="{Binding HasSelectedTake}"
                            ToolTip="Save the selected take as a MIDI file"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Set A" Style="{StaticResource Style.PanelButton}"
                                Command="{Binding SetLoopStartCommand}"
                                ToolTip="Mark the loop start at the playhead (while playing)"/>
                        <Button Content="Set B" Style="{StaticResource Style.PanelButton}" Margin="4,0,0,0"
                                Command="{Binding SetLoopEndCommand}"
                                ToolTip="Mark the loop end at the playhead (while playing) and loop"/>
                        <Button Content="Clear" Style="{StaticResource Style.PanelButton}" Margin="4,0,0,0"
                                Command="{Binding ClearLoopRegionCommand}"
                                ToolTip="Loop the whole take again"/>
                        <TextBlock Text="{Binding LoopRegionText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource Brush.Text.Muted}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>

                <views:TakeTimeline x:Name="Timeline"
                                    Take="{Binding SelectedTake}"
                                    Position="{Binding PlaybackPosition}"
                                    ShowPlayhead="{Binding IsPlaying}"
                                    LoopStart="{Binding LoopStart}"
                                    LoopEnd="{Binding LoopEnd}"
                                    RegionSelected="Timeline_RegionSelected"
                                    SeekRequested="Timeline_SeekRequested"
                                    ToolTip="Drag to set an A–B loop. Click while playing to jump there."/>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
