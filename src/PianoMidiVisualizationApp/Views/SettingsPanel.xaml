<UserControl x:Class="PianoMidiVisualizationApp.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Settings > devices and sound. One group per job, each kept whole: the panel wraps
         between groups, never inside one, so no control is ever stranded on a line of its own
         at the 900px minimum. Labels read like the practice toolbar's "Key": quiet, no colons. -->
    <UserControl.Resources>
        <Style x:Key="Style.SettingsGroup" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,24,3"/>
        </Style>
        <Style x:Key="Style.SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.SurfaceAlt}" Padding="12,7">
        <WrapPanel Orientation="Horizontal">
            <!-- Keyboard: which one, connect, activity, and look again for new devices -->
            <StackPanel Style="{StaticResource Style.SettingsGroup}">
                <TextBlock Text="Keyboard" Style="{StaticResource Style.SettingsLabel}"/>
                <ComboBox Width="180" Height="26"
                          ItemsSource="{Binding Settings.MidiDevices}"
                          SelectedItem="{Binding Settings.SelectedMidiDevice}"
                          DisplayMemberPath="Name"
                          AutomationProperties.Name="MIDI keyboard"/>
                <!-- Show Connect when NOT connected -->
                <Button Content="Connect" Margin="4,0,0,0" Padding="10,3"
                        Command="{Binding ConnectMidiCommand}">
                    <Button.Style>
                        <!-- BasedOn is required: a local Style without it would discard the dark template. -->
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMidiConnected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- Show Disconnect when connected -->
                <Button Content="Disconnect" Margin="4,0,0,0" Padding="10,3"
                        Command="{Binding DisconnectMidiCommand}"
                        Visibility="{Binding IsMidiConnected, Converter={StaticResource BoolToVisConverter}}"/>
                <!-- MIDI activity indicator -->
                <Ellipse Width="10" Height="10" Margin="8,0,0,0" VerticalAlignment="Center"
                         ToolTip="{Binding LastMidiMessage}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Brush.Midi.Idle}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMidiConnected}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Midi.Connected}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MidiActivity}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Midi.Active}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <!-- In this group, beside the device it refreshes, rather than trailing the panel
                     where it wrapped onto a line of its own. -->
                <Button Content="&#xE72C;" Margin="6,0,0,0" VerticalAlignment="Center"
                        Style="{StaticResource Style.GlyphButton}"
                        Command="{Binding RefreshDeviceListCommand}"
                        ToolTip="Look again for keyboards and audio outputs"
                        AutomationProperties.Name="Look again for devices"/>
            </StackPanel>

            <!-- Output: driver type, then the device for it -->
            <StackPanel Style="{StaticResource Style.SettingsGroup}">
                <TextBlock Text="Output" Style="{StaticResource Style.SettingsLabel}"/>
                <RadioButton Content="ASIO" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"
                             IsChecked="{Binding Settings.UseAsio}" GroupName="AudioMode" Margin="0,0,8,0"
                             ToolTip="Lowest latency. Needs an ASIO driver, e.g. your interface's or ASIO4ALL."/>
                <RadioButton Content="WASAPI" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"
                             IsChecked="{Binding Settings.UseAsio, Converter={StaticResource InverseBoolConverter}}"
                             GroupName="AudioMode" Margin="0,0,8,0"
                             ToolTip="Windows' own audio. Works everywhere, with a little more latency."/>
                <!-- ASIO drivers shown when ASIO selected -->
                <ComboBox Width="200" Height="26"
                          ItemsSource="{Binding Settings.AsioDriverNames}"
                          SelectedItem="{Binding Settings.SelectedAudioDriver}"
                          AutomationProperties.Name="ASIO driver"
                          Visibility="{Binding Settings.UseAsio, Converter={StaticResource BoolToVisConverter}}"/>
                <!-- WASAPI devices shown when WASAPI selected -->
                <ComboBox Width="200" Height="26"
                          ItemsSource="{Binding Settings.WasapiDeviceNames}"
                          SelectedItem="{Binding Settings.SelectedAudioDriver}"
                          AutomationProperties.Name="Audio device">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Settings.UseAsio}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
            </StackPanel>

            <!-- Piano sound: the file, by name (the full path is its tooltip), and audio on/off -->
            <StackPanel Style="{StaticResource Style.SettingsGroup}">
                <TextBlock Text="Piano sound" Style="{StaticResource Style.SettingsLabel}"/>
                <Grid Width="170" Height="26">
                    <TextBox IsReadOnly="True"
                             Text="{Binding Settings.SoundFontFileName, Mode=OneWay}"
                             ToolTip="{Binding Settings.SoundFontPath}"
                             AutomationProperties.Name="Piano sound file"/>
                    <!-- Placeholder: a read-only box showing nothing reads as broken. -->
                    <TextBlock Text=".sf2 or .sfz file" Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               FontSize="12" Foreground="{StaticResource Brush.Text.Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.SoundFontFileName}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Content="Choose…" Margin="4,0,0,0" Padding="10,3"
                        Command="{Binding BrowseSoundFontCommand}"
                        ToolTip="Pick a SoundFont (.sf2) or SFZ (.sfz) piano"/>
                <Button Content="Start audio" Margin="12,0,4,0" Padding="10,3"
                        Command="{Binding StartAudioCommand}"
                        IsEnabled="{Binding IsAudioRunning, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Stop" Padding="10,3"
                        Command="{Binding StopAudioCommand}"
                        IsEnabled="{Binding IsAudioRunning}"
                        ToolTip="Stop audio"/>
            </StackPanel>

            <!-- Levels. The master Volume scales the metronome Click too. -->
            <StackPanel Style="{StaticResource Style.SettingsGroup}">
                <TextBlock Text="Volume" Style="{StaticResource Style.SettingsLabel}"/>
                <Slider Width="100" Minimum="0" Maximum="1" Value="{Binding Settings.Volume}"
                        VerticalAlignment="Center" TickFrequency="0.1"
                        AutomationProperties.Name="Volume"/>
                <TextBlock Text="Click" Style="{StaticResource Style.SettingsLabel}" Margin="16,0,8,0"/>
                <Slider Width="80" Minimum="0" Maximum="1" Value="{Binding Settings.MetronomeVolume}"
                        VerticalAlignment="Center" TickFrequency="0.1"
                        ToolTip="Metronome volume, relative to the master volume"
                        AutomationProperties.Name="Metronome volume"/>
            </StackPanel>

            <!-- AI Music Assistant key -->
            <StackPanel Style="{StaticResource Style.SettingsGroup}">
                <TextBlock Text="Gemini key" Style="{StaticResource Style.SettingsLabel}"/>
                <PasswordBox x:Name="ApiKeyBox" Width="140" Height="26"
                             PasswordChanged="ApiKeyBox_PasswordChanged"
                             AutomationProperties.Name="Google Gemini API key"
                             ToolTip="Your Google Gemini API key, for the AI Music Assistant. Your messages, the chord you hold, the key and your progression are sent to Google."/>
            </StackPanel>
        </WrapPanel>
    </Border>
</UserControl>
