<UserControl x:Class="PianoMidiVisualizationApp.Views.SongPracticePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PianoMidiVisualizationApp.Views"
             xmlns:vm="clr-namespace:PianoMidiVisualizationApp.ViewModels"
             xmlns:converters="clr-namespace:PianoMidiVisualizationApp.Converters"
             x:Name="Root">

    <!-- Song practice: fills the stage's readout row while it is on. DataContext is the
         SongPracticeViewModel. Buttons are Focusable="False", like the rest of the toolbars, so
         a clicked button never holds focus and swallows Space (save chord). -->
    <UserControl.Resources>
        <converters:SongPartBrushConverter x:Key="SongPartBrush"/>

        <Style x:Key="Style.SongButton" TargetType="ButtonBase">
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A Segoe MDL2 glyph that takes its colour from the button it sits in. -->
        <Style x:Key="Style.SongGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        </Style>

        <Style x:Key="Style.SongLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Style.SongValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="Style.SongSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="Fill" Value="{StaticResource Brush.Separator}"/>
        </Style>

        <!-- Everything that only makes sense with a song loaded. -->
        <Style x:Key="Style.NeedsSong" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSong}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- transport -->
            <RowDefinition Height="*"/>      <!-- falling notes -->
        </Grid.RowDefinitions>

        <!-- ===================== Transport ===================== -->
        <Border Grid.Row="0" Margin="16,8,16,6" Padding="8,4" CornerRadius="6"
                Background="{StaticResource Brush.Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- One line that scales down rather than wrapping, like the practice toolbar:
                     a second line would take height from the notes. -->
                <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Height="30">
                        <Button Style="{StaticResource Style.SongButton}" Command="{Binding OpenSongCommand}"
                                ToolTip="Open a MIDI song (Ctrl+O)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource Style.SongGlyph}"/>
                                <TextBlock Text="Open" Margin="6,0,2,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Style="{StaticResource Style.NeedsSong}">
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="220">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SongPath}"/>
                                <TextBlock Text="{Binding SongDetails}" FontSize="10"
                                           Foreground="{StaticResource Brush.Text.Muted}"/>
                            </StackPanel>

                            <Rectangle Style="{StaticResource Style.SongSeparator}"/>

                            <Button Style="{StaticResource Style.SongButton}" Command="{Binding RestartCommand}"
                                    ToolTip="Back to the start, or to the loop start">
                                <TextBlock Text="&#xE892;" Style="{StaticResource Style.SongGlyph}"/>
                            </Button>
                            <Button Margin="2,0,0,0" Command="{Binding TogglePlayCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Style.SongButton}">
                                        <Setter Property="ToolTip" Value="Play"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="ToolTip" Value="Pause"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Style.SongGlyph}">
                                            <Setter Property="Text" Value="&#xE768;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Text" Value="&#xE769;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <TextBlock Text="Bar" Style="{StaticResource Style.SongLabel}" Margin="10,0,6,0"/>
                            <!-- Fixed width, so the bar does not shift as the digits change -->
                            <TextBlock Text="{Binding BarText}" Style="{StaticResource Style.SongValue}"
                                       Width="62" TextAlignment="Left"/>

                            <Rectangle Style="{StaticResource Style.SongSeparator}"/>

                            <TextBlock Text="Speed" Style="{StaticResource Style.SongLabel}" Margin="0,0,4,0"/>
                            <Button Content="&#x2212;" Style="{StaticResource Style.SongButton}"
                                    Command="{Binding DecreaseSpeedCommand}" ToolTip="Slower"/>
                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Style.SongValue}" Width="38"
                                       PreviewMouseWheel="Speed_PreviewMouseWheel"
                                       ToolTip="Playback speed, 25% to 100%. Scroll to change."/>
                            <Button Content="+" Style="{StaticResource Style.SongButton}"
                                    Command="{Binding IncreaseSpeedCommand}" ToolTip="Faster"/>

                            <Rectangle Style="{StaticResource Style.SongSeparator}"/>

                            <ToggleButton Style="{StaticResource Style.SongButton}" IsChecked="{Binding IsLoopEnabled}"
                                          ToolTip="Loop a range of bars">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EE;" Style="{StaticResource Style.SongGlyph}"/>
                                    <TextBlock Text="Loop" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <TextBlock Text="bars" Style="{StaticResource Style.SongLabel}" Margin="8,0,4,0"/>
                            <Button Content="&#x2212;" Style="{StaticResource Style.SongButton}" MinWidth="20"
                                    Command="{Binding LoopStartEarlierCommand}" ToolTip="Loop from an earlier bar"/>
                            <TextBlock Text="{Binding LoopStartBar}" Style="{StaticResource Style.SongValue}" MinWidth="24"
                                       PreviewMouseWheel="LoopStart_PreviewMouseWheel"
                                       ToolTip="First bar of the loop. Scroll to change."/>
                            <Button Content="+" Style="{StaticResource Style.SongButton}" MinWidth="20"
                                    Command="{Binding LoopStartLaterCommand}" ToolTip="Loop from a later bar"/>
                            <TextBlock Text="–" Style="{StaticResource Style.SongLabel}" Margin="4,0"/>
                            <Button Content="&#x2212;" Style="{StaticResource Style.SongButton}" MinWidth="20"
                                    Command="{Binding LoopEndEarlierCommand}" ToolTip="Loop to an earlier bar"/>
                            <TextBlock Text="{Binding LoopEndBar}" Style="{StaticResource Style.SongValue}" MinWidth="24"
                                       PreviewMouseWheel="LoopEnd_PreviewMouseWheel"
                                       ToolTip="Last bar of the loop. Scroll to change."/>
                            <Button Content="+" Style="{StaticResource Style.SongButton}" MinWidth="20"
                                    Command="{Binding LoopEndLaterCommand}" ToolTip="Loop to a later bar"/>

                            <Rectangle Style="{StaticResource Style.SongSeparator}"/>

                            <ToggleButton Style="{StaticResource Style.SongButton}" IsChecked="{Binding IsTrackListOpen}"
                                          ToolTip="Choose which parts you play">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" Style="{StaticResource Style.SongGlyph}"/>
                                    <TextBlock Text="Tracks" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>

                            <Button Content="✕" Margin="6,0,0,0" Style="{StaticResource Style.IconButton}"
                                    Focusable="False" VerticalAlignment="Center"
                                    Command="{Binding CloseSongCommand}" ToolTip="Close the song"/>
                        </StackPanel>
                    </StackPanel>
                </Viewbox>

                <!-- The chord readout, shrunk to one line while the notes have the readout row.
                     Bound through the window, whose DataContext holds the analysis. -->
                <TextBlock Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center"
                           DataContext="{Binding DataContext.Analysis, RelativeSource={RelativeSource AncestorType=Window}}"
                           ToolTip="The chord being held"><Run
                               Text="{Binding Name, Mode=OneWay}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text.Primary}"/><Run
                               Text="{Binding Function, Mode=OneWay, StringFormat='  {0}'}" FontSize="14"
                               FontWeight="SemiBold" Style="{StaticResource Style.Function.Numeral}"/></TextBlock>
            </Grid>
        </Border>

        <!-- ===================== Falling notes ===================== -->
        <views:FallingNotesControl x:Name="Notes" Grid.Row="1"
                                   Session="{Binding}"
                                   Keyboard="{Binding KeyboardControl, ElementName=Root}"/>

        <!-- No song yet -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSong}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="No song loaded" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource Brush.Text.Secondary}"/>
            <TextBlock Margin="0,6,0,12" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{StaticResource Brush.Text.Muted}"
                       Text="Open a MIDI file and its notes fall onto the keys below."/>
            <Button HorizontalAlignment="Center" Padding="14,5" Focusable="False"
                    Command="{Binding OpenSongCommand}" Content="Open MIDI song…  (Ctrl+O)"/>
        </StackPanel>

        <!-- ===================== Track list =====================
             Opens by itself after a song loads, so the roles are seen before playing. -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                MinWidth="420" MaxWidth="560" Padding="14,10,14,12" CornerRadius="6"
                Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                Visibility="{Binding IsTrackListOpen, Converter={StaticResource BoolToVisConverter}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource Style.IconButton}"
                            Focusable="False" Command="{Binding CloseTrackListCommand}" ToolTip="Close"/>
                    <TextBlock Text="Who plays what" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Text.Primary}"/>
                </DockPanel>

                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="16,4"
                        Focusable="False" Command="{Binding StartFromTrackListCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="Play"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Content" Value="Done"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                    <ItemsControl ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SongPartViewModel}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding ColorIndex, Converter={StaticResource SongPartBrush}}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Details}" FontSize="10"
                                                   Foreground="{StaticResource Brush.Text.Muted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Width="104" Height="26" VerticalAlignment="Center"
                                              ItemsSource="{x:Static vm:SongPracticeViewModel.RoleOptions}"
                                              SelectedValuePath="Role"
                                              SelectedValue="{Binding Role}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
