<UserControl x:Class="PianoMidiVisualizationApp.Views.SongPracticePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PianoMidiVisualizationApp.Views"
             xmlns:vm="clr-namespace:PianoMidiVisualizationApp.ViewModels"
             xmlns:converters="clr-namespace:PianoMidiVisualizationApp.Converters"
             x:Name="Root">

    <!-- Song practice: fills the stage's readout row while it is on. DataContext is the
         SongPracticeViewModel. Buttons are Focusable="False", like the rest of the toolbars, so
         a clicked button never holds focus and swallows Space (save chord). -->
    <UserControl.Resources>
        <converters:SongPartBrushConverter x:Key="SongPartBrush"/>

        <Style x:Key="Style.SongButton" TargetType="ButtonBase">
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.On}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.On.Ink}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A Segoe MDL2 glyph that takes its colour from the button it sits in. -->
        <Style x:Key="Style.SongGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Icon}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        </Style>

        <Style x:Key="Style.SongLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Style.SongValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- A number and its − and + buttons, boxed like an input field, so the three read as
             one control. Unboxed, a range read "1 + – – 4 +": the range dash ran into the minus
             buttons on either side of it. -->
        <Style x:Key="Style.SongStepper" TargetType="Border">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.Input}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style x:Key="Style.SongStepButton" TargetType="Button" BasedOn="{StaticResource Style.SongButton}">
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- The margin is the roomy one; a narrow bar tightens it from code-behind. -->
        <Style x:Key="Style.SongSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="Fill" Value="{StaticResource Brush.Separator}"/>
        </Style>

        <!-- The loop range, "1 to 4", each bar in its own stepper box: "to" rather than a dash,
             which looked like one more minus button between them. A template because it is shown
             in two places: inline on a wide bar, in a popup from the range button on a narrow one. -->
        <DataTemplate x:Key="Template.LoopRange">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Style.SongStepper}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="&#x2212;" Style="{StaticResource Style.SongStepButton}"
                                Command="{Binding LoopStartEarlierCommand}" ToolTip="Loop from an earlier bar"/>
                        <TextBlock Text="{Binding LoopStartBar}" Style="{StaticResource Style.SongValue}" MinWidth="24"
                                   PreviewMouseWheel="LoopStart_PreviewMouseWheel"
                                   ToolTip="First bar of the loop. Scroll to change."/>
                        <Button Content="+" Style="{StaticResource Style.SongStepButton}"
                                Command="{Binding LoopStartLaterCommand}" ToolTip="Loop from a later bar"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="to" Style="{StaticResource Style.SongLabel}" Margin="6,0"/>
                <Border Style="{StaticResource Style.SongStepper}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="&#x2212;" Style="{StaticResource Style.SongStepButton}"
                                Command="{Binding LoopEndEarlierCommand}" ToolTip="Loop to an earlier bar"/>
                        <TextBlock Text="{Binding LoopEndBar}" Style="{StaticResource Style.SongValue}" MinWidth="24"
                                   PreviewMouseWheel="LoopEnd_PreviewMouseWheel"
                                   ToolTip="Last bar of the loop. Scroll to change."/>
                        <Button Content="+" Style="{StaticResource Style.SongStepButton}"
                                Command="{Binding LoopEndLaterCommand}" ToolTip="Loop to a later bar"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- The loop range folded into a box that reads "1–4" and drops the steppers down, like
             a ComboBox. Stays down while its popup is open, and ignores the mouse meanwhile: the
             click that closes the popup would otherwise land here and open it again. -->
        <Style x:Key="Style.SongRangeButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,0,8,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{StaticResource Brush.Input}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Path Margin="5,1,0,0" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 8,0"
                                      Stroke="{StaticResource Brush.Text.Muted}" StrokeThickness="1.4"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Text.Muted}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Text.Muted}"/>
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Everything that only makes sense with a song loaded. -->
        <Style x:Key="Style.NeedsSong" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSong}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- transport -->
            <RowDefinition Height="*"/>      <!-- falling notes -->
        </Grid.RowDefinitions>

        <!-- ===================== Transport =====================
             The practice toolbar sits in a flat row above this (see MainWindow), so the top
             margin matches the 6px the lane is given below. -->
        <Border Grid.Row="0" Margin="16,6,16,6" Padding="8,4" CornerRadius="6"
                Background="{StaticResource Brush.Surface}">
            <Grid x:Name="BarGrid" SizeChanged="BarGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- One line, never two: a second line would take height from the notes. On a
                     narrow stage code-behind drops the least needed parts first (see
                     SongPracticePanel.BarDensity) so the text keeps its size; the Viewbox only
                     scales down what still doesn't fit after that. -->
                <Viewbox x:Name="BarViewbox" Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Left">
                    <StackPanel x:Name="BarContent" Orientation="Horizontal" Height="30"
                                SizeChanged="BarContent_SizeChanged">
                        <Button Style="{StaticResource Style.SongButton}" Command="{Binding OpenSongCommand}"
                                ToolTip="Open a MIDI song (Ctrl+O)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource Style.SongGlyph}"/>
                                <TextBlock x:Name="OpenLabel" Text="Open" Margin="6,0,2,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel x:Name="SongControls" Style="{StaticResource Style.NeedsSong}">
                            <!-- The tooltip has it all, for when a narrow bar trims the title and
                                 drops the details -->
                            <StackPanel x:Name="TitleBlock" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="220">
                                <StackPanel.ToolTip>
                                    <TextBlock><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><LineBreak/><Run
                                               Text="{Binding SongDetails, Mode=OneWay}"/><LineBreak/><Run
                                               Text="{Binding SongPath, Mode=OneWay}"/></TextBlock>
                                </StackPanel.ToolTip>
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SongDetailsText" Text="{Binding SongDetails}" FontSize="10"
                                           Foreground="{StaticResource Brush.Text.Muted}"/>
                            </StackPanel>

                            <Rectangle Style="{StaticResource Style.SongSeparator}"/>

                            <Button Style="{StaticResource Style.SongButton}" Command="{Binding RestartCommand}"
                                    ToolTip="Back to the start, or to the loop start">
                                <TextBlock Text="&#xE892;" Style="{StaticResource Style.SongGlyph}"/>
                            </Button>
                            <Button Margin="2,0,0,0" Command="{Binding TogglePlayCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Style.SongButton}">
                                        <Setter Property="ToolTip" Value="Play"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="ToolTip" Value="Pause"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Style.SongGlyph}">
                                            <Setter Property="Text" Value="&#xE768;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Text" Value="&#xE769;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <TextBlock x:Name="BarLabel" Text="Bar" Style="{StaticResource Style.SongLabel}" Margin="10,0,0,0"/>
                            <!-- As wide as the song's last bar ("16 / 16", hidden), so the bar does
                                 not shift as the digits change. Consolas digits are all one width. -->
                            <Grid Margin="6,0,0,0" ToolTip="The bar you are at, of the song's bars">
                                <TextBlock Text="{Binding BarCount, StringFormat='{}{0} / {0}'}"
                                           Style="{StaticResource Style.SongValue}" Visibility="Hidden"/>
                                <TextBlock Text="{Binding BarText}" Style="{StaticResource Style.SongValue}"
                                           TextAlignment="Left"/>
                            </Grid>

                            <Rectangle Style="{StaticResource Style.SongSeparator}"/>

                            <TextBlock x:Name="SpeedLabel" Text="Speed" Style="{StaticResource Style.SongLabel}" Margin="0,0,6,0"/>
                            <Border Style="{StaticResource Style.SongStepper}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&#x2212;" Style="{StaticResource Style.SongStepButton}"
                                            Command="{Binding DecreaseSpeedCommand}" ToolTip="Slower"/>
                                    <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Style.SongValue}" Width="32"
                                               PreviewMouseWheel="Speed_PreviewMouseWheel"
                                               ToolTip="Playback speed, 25% to 100%. Scroll to change."/>
                                    <Button Content="+" Style="{StaticResource Style.SongStepButton}"
                                            Command="{Binding IncreaseSpeedCommand}" ToolTip="Faster"/>
                                </StackPanel>
                            </Border>

                            <Rectangle Style="{StaticResource Style.SongSeparator}"/>

                            <!-- Reads as a sentence, "Loop bars 1 to 4" -->
                            <ToggleButton Style="{StaticResource Style.SongButton}" IsChecked="{Binding IsLoopEnabled}"
                                          ToolTip="Loop a range of bars">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EE;" Style="{StaticResource Style.SongGlyph}"/>
                                    <TextBlock x:Name="LoopLabel" Text="Loop" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel x:Name="InlineLoopRange" Orientation="Horizontal">
                                <TextBlock x:Name="BarsLabel" Text="Bars" Style="{StaticResource Style.SongLabel}" Margin="8,0,0,0"/>
                                <ContentPresenter Margin="6,0,0,0" Content="{Binding}"
                                                  ContentTemplate="{StaticResource Template.LoopRange}"/>
                            </StackPanel>
                            <!-- Narrow bar only: the range above, folded into a dropdown -->
                            <ToggleButton x:Name="LoopRangeButton" Style="{StaticResource Style.SongRangeButton}"
                                          Margin="6,0,0,0" Visibility="Collapsed"
                                          IsChecked="{Binding IsOpen, ElementName=LoopRangePopup, Mode=TwoWay}"
                                          ToolTip="The bars to loop. Click to change them.">
                                <!-- Sized to its text: unlike the bar number, it only changes on a click -->
                                <TextBlock Style="{StaticResource Style.SongValue}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}–{1}">
                                            <Binding Path="LoopStartBar"/>
                                            <Binding Path="LoopEndBar"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </ToggleButton>

                            <Rectangle Style="{StaticResource Style.SongSeparator}"/>

                            <ToggleButton Style="{StaticResource Style.SongButton}" IsChecked="{Binding IsTrackListOpen}"
                                          ToolTip="Choose which parts you play">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" Style="{StaticResource Style.SongGlyph}"/>
                                    <TextBlock x:Name="TracksLabel" Text="Tracks" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>

                            <ComboBox Width="100" Height="26" Margin="6,0,0,0"
                                      ItemsSource="{x:Static vm:SongPracticeViewModel.ModeOptions}"
                                      SelectedValuePath="Mode"
                                      SelectedValue="{Binding Mode}"
                                      ToolTip="Wait for me: the song stops at each of your chords until you play it.&#x0a;Play along: the song keeps going, and notes you miss are counted.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Content="&#xE711;" Margin="6,0,0,0" Style="{StaticResource Style.GlyphButton}"
                                    Focusable="False" VerticalAlignment="Center"
                                    Command="{Binding CloseSongCommand}" ToolTip="Close the song"/>
                        </StackPanel>
                    </StackPanel>
                </Viewbox>

                <!-- The chord readout, shrunk to one line while the notes have the readout row.
                     Bound through the window, whose DataContext holds the analysis. It gets what
                     the bar leaves, never less than SongPracticePanel.ChordReserve, and a long
                     name shrinks to fit rather than squeezing the bar as each chord is played. -->
                <Viewbox Grid.Column="1" Margin="12,0,4,0" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock DataContext="{Binding DataContext.Analysis, RelativeSource={RelativeSource AncestorType=Window}}"
                               ToolTip="The chord being held"><Run
                                   Text="{Binding Name, Mode=OneWay}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}"/><Run
                                   Text="{Binding Function, Mode=OneWay, StringFormat='  {0}'}" FontSize="14"
                                   FontWeight="SemiBold" Style="{StaticResource Style.Function.Numeral}"/></TextBlock>
                </Viewbox>
            </Grid>
        </Border>

        <!-- The loop range, dropped down from LoopRangeButton on a narrow bar. At full size, unlike
             the bar. Nothing in it takes focus, so Space still saves the chord while it is open;
             clicking anywhere else closes it. -->
        <Popup x:Name="LoopRangePopup" PlacementTarget="{Binding ElementName=LoopRangeButton}"
               Placement="Bottom" VerticalOffset="4" StaysOpen="False"
               AllowsTransparency="False" PopupAnimation="None" Focusable="False">
            <Border Background="{StaticResource Brush.Popup.Background}"
                    BorderBrush="{StaticResource Brush.Popup.Border}" BorderThickness="1" Padding="8,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Bars" Style="{StaticResource Style.SongLabel}" Margin="0,0,6,0"/>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Template.LoopRange}"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ===================== Falling notes ===================== -->
        <views:FallingNotesControl x:Name="Notes" Grid.Row="1"
                                   Session="{Binding}"
                                   Keyboard="{Binding KeyboardControl, ElementName=Root}"/>

        <!-- Waiting indicator and score, over the top right of the lane -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,6,24,0" IsHitTestVisible="False"
                    Visibility="{Binding HasSong, Converter={StaticResource BoolToVisConverter}}">
            <Border CornerRadius="9" Padding="8,1" Margin="0,0,10,0" VerticalAlignment="Center"
                    BorderBrush="{StaticResource Brush.Song.Target}" BorderThickness="1"
                    Background="{StaticResource Brush.Song.Overlay}"
                    Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="Waiting for you" FontSize="11" Foreground="{StaticResource Brush.Song.Target}"/>
            </Border>
            <!-- One form for all three counts, the words the Finished card uses. The numbers carry
                 the colour (green correct, red wrong), so the meaning never rests on hue alone.
                 Tabular figures keep the line from twitching as a count gains a digit. -->
            <Border CornerRadius="9" Padding="8,1" Background="{StaticResource Brush.Song.Overlay}" VerticalAlignment="Center">
                <TextBlock FontSize="12" Typography.NumeralAlignment="Tabular"
                           Foreground="{StaticResource Brush.Text.Muted}"><Run
                        Text="{Binding CorrectCount, Mode=OneWay}" FontWeight="SemiBold"
                        Foreground="{StaticResource Brush.Song.Correct}"/><Run
                        Text=" correct   "/><Run
                        Text="{Binding WrongCount, Mode=OneWay}" FontWeight="SemiBold"
                        Foreground="{StaticResource Brush.Song.Wrong}"/><Run
                        Text=" wrong   "/><Run
                        Text="{Binding MissedCount, Mode=OneWay}" FontWeight="SemiBold"
                        Foreground="{StaticResource Brush.Text.Secondary}"/><Run
                        Text=" missed"/></TextBlock>
            </Border>
        </StackPanel>

        <!-- End of the song: the score, and a way to go again -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,12"
                CornerRadius="6" Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel>
                <TextBlock Text="Finished" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{StaticResource Brush.Text.Primary}"/>
                <TextBlock Margin="0,6,0,10" FontSize="12" HorizontalAlignment="Center"
                           Foreground="{StaticResource Brush.Text.Secondary}"><Run
                        Text="{Binding CorrectCount, Mode=OneWay}"/><Run Text=" correct · "/><Run
                        Text="{Binding WrongCount, Mode=OneWay}"/><Run Text=" wrong · "/><Run
                        Text="{Binding MissedCount, Mode=OneWay}"/><Run Text=" missed"/></TextBlock>
                <Button HorizontalAlignment="Center" Padding="14,4" Focusable="False"
                        Style="{StaticResource Style.PrimaryButton}"
                        Command="{Binding TogglePlayCommand}" Content="Play again"/>
            </StackPanel>
        </Border>

        <!-- No song yet -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSong}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="No song loaded" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource Brush.Text.Secondary}"/>
            <TextBlock Margin="0,6,0,12" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{StaticResource Brush.Text.Muted}"
                       Text="Open a MIDI file and its notes fall onto the keys below."/>
            <Button HorizontalAlignment="Center" Padding="14,5" Focusable="False"
                    Style="{StaticResource Style.PrimaryButton}"
                    Command="{Binding OpenSongCommand}" Content="Open MIDI song…  (Ctrl+O)"/>
        </StackPanel>

        <!-- ===================== Track list =====================
             Opens by itself after a song loads, so the roles are seen before playing. -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                MinWidth="420" MaxWidth="560" Padding="14,10,14,12" CornerRadius="6"
                Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                Visibility="{Binding IsTrackListOpen, Converter={StaticResource BoolToVisConverter}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource Style.GlyphButton}"
                            Focusable="False" Command="{Binding CloseTrackListCommand}" ToolTip="Close"/>
                    <TextBlock Text="Who plays what" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Text.Primary}"/>
                </DockPanel>

                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="16,4"
                        Focusable="False" Command="{Binding StartFromTrackListCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Style.PrimaryButton}">
                            <Setter Property="Content" Value="Play"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Content" Value="Done"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                    <ItemsControl ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SongPartViewModel}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding ColorIndex, Converter={StaticResource SongPartBrush}}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Details}" FontSize="10"
                                                   Foreground="{StaticResource Brush.Text.Muted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Width="104" Height="26" VerticalAlignment="Center"
                                              ItemsSource="{x:Static vm:SongPracticeViewModel.RoleOptions}"
                                              SelectedValuePath="Role"
                                              SelectedValue="{Binding Role}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
