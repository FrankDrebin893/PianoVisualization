<UserControl x:Class="PianoMidiVisualizationApp.Views.ProgressionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The chord progression sidebar and its tools: playback, transpose and next-chord ideas.
         DataContext is the MainViewModel, which owns the saved chords; the tools live on its
         ProgressionTools. Every button, toggle and checkbox here is Focusable="False": a focused
         one would take Space, which the window uses to save the current chord. -->
    <UserControl.Resources>
        <Style x:Key="Style.ProgressionTransport" TargetType="ButtonBase">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A next-chord chip: the numeral leads, the chord name follows. -->
        <Style x:Key="Style.SuggestionChip" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Separator}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Text.Faint}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A slim dark scrollbar for the chord list; the stock one is light chrome. Vertical
             only: the list never scrolls sideways. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource Brush.Border}" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Surface}" Padding="8">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Chord Progression"
                       Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="12" FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <!-- ============ Tools ============ -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" DataContext="{Binding ProgressionTools}">
                <!-- Playback: play/stop, loop, how long each chord lasts, and the tempo it uses -->
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding TogglePlaybackCommand}" IsEnabled="{Binding HasChords}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.ProgressionTransport}">
                                <Setter Property="ToolTip" Value="Play the progression (Ctrl+P)"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="ToolTip" Value="Stop (Ctrl+P)"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Path Data="M 0,0 L 9,5.5 L 0,11 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Rectangle Width="9" Height="9"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisConverter}}"/>
                        </Grid>
                    </Button>

                    <ToggleButton Margin="2,0,0,0" IsChecked="{Binding IsLooping}"
                                  Style="{StaticResource Style.ProgressionTransport}"
                                  ToolTip="Loop the progression">
                        <TextBlock Text="&#xE8EE;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>

                    <ComboBox Width="78" Height="26" Margin="6,0,0,0"
                              ItemsSource="{Binding ChordLengths}"
                              SelectedValuePath="Beats"
                              SelectedValue="{Binding BeatsPerChord}"
                              ToolTip="How long each chord sounds, at the metronome's tempo and bar length">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               Text="{Binding DataContext.Settings.MetronomeBpm,
                                      RelativeSource={RelativeSource AncestorType=UserControl},
                                      StringFormat='{}{0} BPM'}"
                               ToolTip="The metronome's tempo, which playback follows"/>
                </StackPanel>

                <!-- Transpose by semitones, optionally carrying the selected key along -->
                <DockPanel Margin="0,6,0,0" LastChildFill="False">
                    <TextBlock Text="Transpose" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Text.Muted}" Margin="2,0,6,0"/>
                    <Button Content="&#x2212;" Width="22" Height="22" Padding="0" Focusable="False"
                            Command="{Binding TransposeDownCommand}" IsEnabled="{Binding HasChords}"
                            ToolTip="Transpose every chord down a semitone"/>
                    <Button Content="+" Width="22" Height="22" Padding="0" Margin="2,0,0,0" Focusable="False"
                            Command="{Binding TransposeUpCommand}" IsEnabled="{Binding HasChords}"
                            ToolTip="Transpose every chord up a semitone"/>
                    <!-- Disabled rather than hidden with no key selected, like Mute out-of-key -->
                    <CheckBox DockPanel.Dock="Right" Content="Move key" FontSize="11" Focusable="False"
                              VerticalAlignment="Center"
                              IsChecked="{Binding TransposeMovesKey}"
                              IsEnabled="{Binding DataContext.Settings.IsKeyHighlightEnabled,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                              ToolTip="Move the selected key along with the chords, so their numerals stay the same"/>
                </DockPanel>
            </StackPanel>

            <!-- ============ Footer: the count, with the suggestions just above it ============ -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding SavedChords.Count, StringFormat='{}{0}/8 chords'}"
                       Foreground="{StaticResource Brush.Text.Faint}" FontSize="10" Margin="0,8,0,0"/>

            <StackPanel DockPanel.Dock="Bottom" DataContext="{Binding ProgressionTools}"
                        Visibility="{Binding ShowSuggestions, Converter={StaticResource BoolToVisConverter}}">
                <Rectangle Height="1" Fill="{StaticResource Brush.Separator}" Margin="0,6,0,8"/>
                <TextBlock FontSize="11" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                           ToolTip="Likely next chords in the selected key. Hover to see one on the keyboard, click to add it."><Run
                               Text="Next chord" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Tertiary}"/><Run
                               Text="{Binding SuggestionsHeader, Mode=OneWay, StringFormat='  {0}'}"
                               Foreground="{StaticResource Brush.Text.Muted}"/></TextBlock>
                <ItemsControl ItemsSource="{Binding Suggestions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Style.SuggestionChip}" Margin="0,0,4,4"
                                    Command="{Binding DataContext.AddSuggestionCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding VoicingText}"
                                    MouseEnter="Suggestion_MouseEnter" MouseLeave="Suggestion_MouseLeave">
                                <!-- The numeral's own tooltip is cleared so the chip's, which spells
                                     out the voicing, shows wherever the pointer is. -->
                                <TextBlock TextTrimming="CharacterEllipsis"><Run
                                               Text="{Binding Function, Mode=OneWay}"
                                               FontSize="14" FontWeight="SemiBold" ToolTip="{x:Null}"
                                               Style="{StaticResource Style.Function.Numeral}"/><Run
                                               Text="{Binding ChordName, Mode=OneWay, StringFormat='  {0}'}"
                                               FontSize="11" Foreground="{StaticResource Brush.Text.Muted}"/></TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ============ The saved chords ============ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl ItemsSource="{Binding SavedChords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Tag carries IsSounding only to raise TargetUpdated, which scrolls
                                 the chord being played into view. -->
                            <Border CornerRadius="4" Margin="0,0,0,6" Padding="7,5" BorderThickness="1"
                                    Tag="{Binding IsSounding, NotifyOnTargetUpdated=True}"
                                    Binding.TargetUpdated="ChordCard_TargetUpdated">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.SurfaceRaised}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSounding}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Hover}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <!-- Numeral inline after the name, so a card grows no
                                             taller; a long pair wraps rather than clipping. -->
                                        <TextBlock Foreground="{StaticResource Brush.Text.Primary}"
                                                   FontSize="16" FontWeight="Bold" TextWrapping="Wrap"><Run
                                                       Text="{Binding ChordName, Mode=OneWay}"/><Run
                                                       Text="{Binding Function, Mode=OneWay, StringFormat='  {0}'}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Style="{StaticResource Style.Function.Numeral}"/></TextBlock>
                                        <TextBlock Text="{Binding NotesDisplay}"
                                                   Foreground="{StaticResource Brush.Text.Muted}"
                                                   FontSize="10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <!-- The sidebar stays in the window's visual tree (this is one
                                         reason the settings overlay is a Grid child, not a Popup) -->
                                    <Button Grid.Column="1" Content="✕"
                                            Style="{StaticResource Style.IconButton}" Focusable="False"
                                            Command="{Binding DataContext.RemoveChordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Top" ToolTip="Remove chord"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
