<UserControl x:Class="PianoMidiVisualizationApp.Views.PianoControlsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Settings > Piano controls (DataContext: PianoControlsViewModel). One row per action:
         what it is and its keyboard shortcut, the control learned for it, Learn and Clear.
         Nothing here takes focus: a focused button would claim Space, the save-chord key, and
         Space has to keep working while you try out a mapping with Settings still open. -->
    <UserControl.Resources>
        <!-- The chip showing a row's control (DataContext: PianoControlRowViewModel). -->
        <Style x:Key="Style.TriggerChip" TargetType="Border">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Brush.Learn.Chip}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Separator}"/>
            <Setter Property="ToolTip" Value="{Binding TriggerToolTip}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasTrigger}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLearning}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Learn.Listening}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFiring}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Learn.FiredFill}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Learn.Fired}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Style.TriggerChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Faint}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasTrigger}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLearning}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Learn.Listening}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- While listening, the chip's amber ring breathes, so the app visibly waits on the
             piano. It is the one motion in this panel, and only runs while Learn is on. -->
        <Style x:Key="Style.ListeningRing" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Learn.Listening}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLearning}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Breathe">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.85" To="0.15"
                                                 Duration="0:0:0.7">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="Breathe"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Style.LearnButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="Learn"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLearning}" Value="True">
                    <Setter Property="Content" Value="Cancel"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Hidden rather than collapsed without a control, so Learn never shifts sideways. -->
        <Style x:Key="Style.ClearButton" TargetType="Button" BasedOn="{StaticResource Style.IconButton}">
            <Setter Property="Content" Value="Clear"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasTrigger}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLearning}" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.SurfaceAlt}" Padding="12,10,12,10"
            BorderBrush="{StaticResource Brush.Separator}" BorderThickness="0,1,0,0">
        <StackPanel>
            <TextBlock Text="Piano controls" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Primary}"/>

            <!-- How Learn works, what it is listening for, or what it just learned. MinHeight
                 keeps the rows from jumping as the message changes length. -->
            <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                       MinHeight="16" Margin="0,2,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLearning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Learn.Listening}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Two columns, filled row by row: the actions are ordered in related pairs. Capped
                 in width, so a wide window doesn't stretch the chips into long empty bars. -->
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False"
                          MaxWidth="920" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,20,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="150"/>
                                <ColumnDefinition Width="*" MinWidth="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Run Text="{Binding Label, Mode=OneWay}" FontSize="12"
                                     Foreground="{StaticResource Brush.Text.Secondary}"/><Run
                                     Text="{Binding Shortcut, Mode=OneWay, StringFormat='  {0}'}" FontSize="11"
                                     Foreground="{StaticResource Brush.Text.Faint}"/>
                            </TextBlock>

                            <Grid Grid.Column="1">
                                <Border Style="{StaticResource Style.TriggerChip}">
                                    <TextBlock Text="{Binding TriggerText}" Style="{StaticResource Style.TriggerChipText}"/>
                                </Border>
                                <Border Style="{StaticResource Style.ListeningRing}"/>
                            </Grid>

                            <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource Style.LearnButton}"
                                    Command="{Binding DataContext.LearnCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Grid.Column="3" Margin="2,0,0,0" Style="{StaticResource Style.ClearButton}"
                                    ToolTip="Forget this control, so it plays normally again"
                                    Command="{Binding DataContext.ClearCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
