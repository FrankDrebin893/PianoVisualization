<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the README screenshots from the real MainWindow, off-screen, with fake MIDI and
       audio. Not part of the solution, so `dotnet build` of the app never builds it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Must match the app: referencing a self-contained exe from a framework-dependent one
         fails with NETSDK1151. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\PianoMidiVisualizationApp\PianoMidiVisualizationApp.csproj" />
  </ItemGroup>

</Project>
